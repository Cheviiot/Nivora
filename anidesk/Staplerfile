name='anidesk'
version='0.0.1-beta.7'
release=15
debian_version='0.0.1.beta.7'

summary='Unofficial desktop client for Anixart'
summary_ru='Неофициальный настольный клиент Anixart'
desc='AniDesk is an unofficial desktop client for the Anixart service.'
desc_ru='AniDesk — неофициальный настольный клиент сервиса Anixart.'
group='Video/Players'
homepage='https://github.com/theDesConnet/AniDesk'
maintainer='Cheviiot <Cheviiot@users.noreply.github.com>'

license=('GPL-2.0-only')

appstream_app_id='anidesk'
appstream_name='AniDesk'
appstream_developer='theDesConnet'

architectures=('amd64')
compatible_with=('altlinux_p11')
disable_network=1

provides=()
replaces=('anidesk')
conflicts=()

auto_reqprov_method='dirty'
auto_req=1
auto_prov=0

# Chromium loads notification and GPU libraries dynamically and runs xdg tools.
deps=('libnotify' 'xdg-utils' 'libvulkan1' 'mesa-dri-drivers')
opt_deps=('gnome-keyring')
build_deps=('binutils' 'python3')

sources=(
	"https://github.com/theDesConnet/AniDesk/releases/download/v${version}/anidesk_${debian_version}_amd64.deb?~archive=false&~name=anidesk.deb"
	'local:///anidesk.png'
	'local:///anidesk-wrapper'
	'local:///LICENSE?nivora=anidesk'
	'local:///anidesk.metainfo.xml?nivora=anidesk'
	'local:///patch-endpoint-setting.py'
)
checksums=(
	'sha256:70fc1207824757f7ddab63f9e210f31bb907ea43dee3d2827fe79c3ef00252b6'
	'sha256:6d7791424bd7db712b121f7e66206289b1d31eb2a8ea998d9aeced2c7075dfe8'
	'sha256:f58b9f720bd63ff49053f949dd3f0a738afc2aa2cee57fedbd2b73440c123721'
	'sha256:892e6b268f44a850a102cc6367fec45853fe3556840d44a6106f08487553e6c4'
	'sha256:55919822fdba837e19f9010e00c6e4aa9f4d1a3e6826a8049d13cfaa942bf239'
	'sha256:4dd92006a84d8e3350a8d4e3dd8904842ef77cc27a527000ecaedd99ae4b492f'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	cd "${srcdir}" || return 1
	extracted="${srcdir}/extracted"
	app_dir="${pkgdir}/usr/lib/anidesk"
	mkdir -p "${extracted}"
	ar x anidesk.deb || return 1
	tar -xf data.tar.* -C "${extracted}" || return 1

	install -dm755 "${pkgdir}/usr/lib"
	cp -a "${extracted}/usr/lib/anidesk" "${pkgdir}/usr/lib/" || return 1
	chmod 4755 "${app_dir}/chrome-sandbox" || return 1
	chmod 755 "${app_dir}/anidesk" || return 1
	python3 patch-endpoint-setting.py "${app_dir}/resources/app.asar" || return 1
	install -Dm755 anidesk-wrapper "${pkgdir}/usr/bin/anidesk"

	install -dm755 "${pkgdir}/usr/share"
	cp -a "${extracted}/usr/share/applications" "${extracted}/usr/share/doc" \
		"${extracted}/usr/share/pixmaps" "${pkgdir}/usr/share/" || return 1
	test -f "${pkgdir}/usr/share/applications/anidesk.desktop" || return 1
	install -Dm644 anidesk.png "${pkgdir}/usr/share/pixmaps/anidesk.png"
	install -Dm644 anidesk.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/anidesk.png"
	install -Dm644 anidesk.metainfo.xml "${pkgdir}/usr/share/metainfo/anidesk.metainfo.xml"

	install-license LICENSE "anidesk/LICENSE.nivora"
	install-license "${app_dir}/LICENSES.chromium.html" "anidesk/LICENSES.chromium.html"
	install-license "${extracted}/usr/share/doc/anidesk/copyright" "anidesk/LICENSE.electron"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/anidesk.metainfo.xml" \
		"/usr/lib/anidesk/**/*" \
		"/usr/share/doc/anidesk/*" \
		"/usr/share/icons/hicolor/256x256/apps/anidesk.png" \
		"/usr/share/pixmaps/anidesk.png"
}
