name='antigravity'
version='2.32.1'
release=1
# Full hub release id from the download page; version alone is not enough
# because Google pins each build under <version>-<id>/
# shortcut: detector only bumps version=, refresh upstream_hub from the download page when updating
upstream_hub='2.32.1-6001966350991360'
summary='Google Antigravity App'
summary_ru='Приложение Google Antigravity'
group='Development/Tools'
desc='Official Google Antigravity desktop application for Linux.'
desc_ru='Официальное десктопное приложение Google Antigravity для Linux.'
homepage='https://antigravity.google/download/'
maintainer='Cheviiot <Cheviiot@users.noreply.github.com>'

architectures=('amd64' 'arm64')
compatible_with=('altlinux')

license=('LicenseRef-proprietary')

appstream_app_id='com.google.Antigravity'
appstream_name='Antigravity'
appstream_developer='Google'
nonfree=1
nonfree_msg='Antigravity является проприетарным приложением Google. Использование Antigravity, учётной записи Google, сетевых функций и сервиса регулируется условиями Google.'
nonfree_url='https://antigravity.google/terms'

provides=()
replaces=('antigravity')
conflicts=()

auto_reqprov_method="dirty"
auto_req=1
auto_prov=0
disable_network=1

# auto_req covers DT_NEEDED of the main Electron binary. The rest stays
# explicit because Chromium loads it via dlopen / subprocess, same pattern
# as other Electron packages in this catalog.
deps=('libnotify' 'libsecret' 'libXtst' 'libXScrnSaver' 'xdg-utils' 'libuuid')

opt_deps=('libappindicator-gtk3' 'ca-certificates' 'gnome-keyring' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk')

build_deps=('binutils')

sources=(
	"https://storage.googleapis.com/antigravity-public/antigravity-hub/${upstream_hub}/linux-x64/Antigravity.tar.gz?~archive=false&~name=Antigravity.tar.gz"
	'local:///com.google.Antigravity.desktop'
	'local:///com.google.Antigravity.png'
	'local:///LICENSE?nivora=antigravity'
	'local:///com.google.Antigravity.metainfo.xml?nivora=antigravity'
)

sources_arm64=(
	"https://storage.googleapis.com/antigravity-public/antigravity-hub/${upstream_hub}/linux-arm/Antigravity.tar.gz?~archive=false&~name=Antigravity.tar.gz"
	'local:///com.google.Antigravity.desktop'
	'local:///com.google.Antigravity.png'
	'local:///LICENSE?nivora=antigravity'
	'local:///com.google.Antigravity.metainfo.xml?nivora=antigravity'
)

