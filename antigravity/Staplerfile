package() {
	# Google's download path includes the build ID as well as the version.
	[[ "${upstream_hub}" == "${version}-"* ]] || {
		echo "upstream_hub=${upstream_hub} does not start with version=${version}-" >&2
		return 1
	}

	unpack_dir="$(mktemp -d "${srcdir}/antigravity-unpack.XXXXXX")" || return 1
	tar --no-same-owner --no-same-permissions -xzf "${srcdir}/Antigravity.tar.gz" -C "${unpack_dir}" || return 1
	roots=("${unpack_dir}"/*)
	if [[ "${#roots[@]}" != 1 || ! -d "${roots[0]}" ]]; then
		echo 'Expected one Antigravity payload directory in the archive' >&2
		return 1
	fi
	python3 "${srcdir}/validate-payload.py" "${roots[0]}" "${version}" || return 1

	app_dir="${pkgdir}/opt/antigravity"
	install -dm755 "${pkgdir}/opt"
	mv -T "${roots[0]}" "${app_dir}" || return 1
	chmod 755 "${app_dir}/antigravity"
	chmod 4755 "${app_dir}/chrome-sandbox"
	# Stapler manages updates for this installation.
	rm -f "${app_dir}/resources/app-update.yml"

	# Electron uses the desktop ID for window matching and the OAuth callback.
	install -Dm755 "${srcdir}/antigravity-launcher" "${pkgdir}/usr/bin/antigravity"
	install -Dm644 "${srcdir}/antigravity.desktop" "${pkgdir}/usr/share/applications/antigravity.desktop"
	install -Dm644 "${srcdir}/com.google.Antigravity.png" \
		"${pkgdir}/usr/share/icons/hicolor/256x256/apps/com.google.Antigravity.png"
	install -Dm644 "${srcdir}/com.google.Antigravity.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/com.google.Antigravity.metainfo.xml"

	install-license "${srcdir}/LICENSE" "antigravity/LICENSE.nivora"
	install-license "${app_dir}/LICENSES.chromium.html" "antigravity/LICENSES.chromium.html"
	install-license "${app_dir}/LICENSE.electron.txt" "antigravity/LICENSE.electron.txt"
}

files() {
	files-find "/opt/antigravity/**/*"
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/com.google.Antigravity.metainfo.xml" \
		"/usr/share/icons/hicolor/256x256/apps/com.google.Antigravity.png"
}
