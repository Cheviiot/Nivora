package() {
	cd "${srcdir}"

	[[ "${upstream_hub}" == "${version}-"* ]] || {
		echo "upstream_hub=${upstream_hub} does not start with version=${version}-" >&2
		return 1
	}

	# A fresh directory prevents a previous architecture/build from being
	# selected from leftovers in srcdir. Both official tar layouts are checked.
	unpack_dir="$(mktemp -d "${srcdir}/antigravity-unpack.XXXXXX")"
	tar --no-same-owner --no-same-permissions -xzf Antigravity.tar.gz -C "${unpack_dir}" || return 1
	roots=("${unpack_dir}"/*)
	if [[ "${#roots[@]}" != 1 || ! -d "${roots[0]}" ]]; then
		echo 'Expected one Antigravity payload directory in the archive' >&2
		return 1
	fi
	payload="${roots[0]}"
	python3 "${srcdir}/validate-payload.py" "${payload}" "${version}" || return 1

	install -dm755 "${pkgdir}/opt/antigravity"
	cp -a "${payload}/." "${pkgdir}/opt/antigravity/"
	chmod 755 "${pkgdir}/opt/antigravity/antigravity"
	chmod 4755 "${pkgdir}/opt/antigravity/chrome-sandbox"

	# Electron's own auto-updater has nothing to manage under Stapler.
	rm -f "${pkgdir}/opt/antigravity/resources/app-update.yml"

	install -Dm755 antigravity-launcher "${pkgdir}/usr/bin/antigravity"

	# Electron derives this desktop name from the unmodified productName.
	# One entry owns the Wayland identity, menu launcher and OAuth protocol.
	# RPM removes the old com.google.Antigravity.desktop during upgrade.
	install-desktop antigravity.desktop
	install -Dm644 com.google.Antigravity.png \
		"${pkgdir}/usr/share/icons/hicolor/256x256/apps/com.google.Antigravity.png"

	# The AppStream component claims this desktop id; make the build
	# fail here rather than shipping a component nothing can launch.
	test -f "${pkgdir}/usr/share/applications/antigravity.desktop"
	install -Dm644 "${srcdir}/com.google.Antigravity.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/com.google.Antigravity.metainfo.xml"
	install-license LICENSE "antigravity/LICENSE.nivora"
	install -Dm644 "${pkgdir}/opt/antigravity/LICENSES.chromium.html" \
		"${pkgdir}/usr/share/licenses/antigravity/LICENSES.chromium.html"
	install -Dm644 "${pkgdir}/opt/antigravity/LICENSE.electron.txt" \
		"${pkgdir}/usr/share/licenses/antigravity/LICENSE.electron.txt"
}

files() {
	files-find "/opt/antigravity/**/*"
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/com.google.Antigravity.metainfo.xml" \
		"/usr/share/icons/hicolor/256x256/apps/com.google.Antigravity.png"
}
