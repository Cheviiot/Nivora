name='balena-etcher'
version='2.1.7'
release=3
summary='Flash OS images to SD cards and USB drives, safely and easily.'
summary_ru='Безопасная и простая запись образов систем на SD-карты и USB-накопители.'
group='System/Configuration/Hardware'
desc='Etcher is a powerful OS image flasher built with web technologies to ensure flashing an SDCard or USB drive is a pleasant and safe experience. It protects you from accidentally writing to your hard-drives, ensures every byte of data was written correctly and much more.'
desc_ru='Etcher — мощное средство записи образов систем, построенное на веб-технологиях, чтобы запись на SD-карту или USB-накопитель была удобной и безопасной. Оно защищает от случайной записи на жёсткие диски, проверяет корректность каждого записанного байта и многое другое.'
homepage='https://etcher.balena.io/'
maintainer='Balena Ltd. <hello@balena.io>'

architectures=('amd64')
compatible_with=('altlinux')

license=('Apache-2.0')

appstream_app_id='balena-etcher'
appstream_name='balenaEtcher'

provides=()
replaces=('balena-etcher')
conflicts=()

# auto_req covers the real DT_NEEDED (readelf -d confirmed across the main
# binary, resources/etcher-util, and the bundled libEGL/libGLESv2/
# libvk_swiftshader/native-module files: gtk3, nss, at-spi2, gbm, xcb,
# alsa, atk, cairo, cups, dbus, expat, glib2, nspr, pango, X11 stack,
# glibc/libstdc++). The rest stays explicit: xdg-utils is a subprocess
# tool, libnotify/libXtst/libXScrnSaver are dlopen'd by Chromium like the
# rest of the catalog's Electron packages, and polkit/fontconfig/
# libfreetype/libgdk-pixbuf/liblzma/libXcursor/libXi/libXrender never show
# up in any binary's DT_NEEDED either - unlike the confirmed-dlopen'd
# libraries there's no direct evidence for *why*, so they stay explicit
# out of caution instead of being dropped on an assumption.
auto_reqprov_method="dirty"
auto_req=1
auto_prov=0
disable_network=1

deps=(
	'libnotify' 'libXtst' 'xdg-utils' 'fontconfig' 'libfreetype'
	'libgdk-pixbuf' 'liblzma' 'libXcursor' 'libXi' 'libXrender'
	'libXScrnSaver' 'polkit'
)

# ALT's apt-rpm cannot express an alternative in a dependency at all, and
# opt_deps never reach the built RPM anyway, so each agent is listed on its
# own line instead of a pseudo-alternative string that nothing can parse.
opt_deps=(
	'polkit-gnome'
	'polkit-kde-agent'
	'lxqt-policykit'
	'xfce-polkit'
	'gvfs'
)

build_deps=('binutils')

sources=(
	"https://github.com/balena-io/etcher/releases/download/v${version}/balena-etcher_${version}_amd64.deb?~archive=false&~name=balena-etcher.deb"
	"https://raw.githubusercontent.com/balena-io/etcher/v${version}/LICENSE?~archive=false&~name=LICENSE"
	'local:///balena-etcher.metainfo.xml?nivora=balena-etcher'
)

checksums=(
	'sha256:9dbea6165ddee1ec1f1b7a38fe92f0d2c54c6217710438a7af6752c267d19395'
	'sha256:39445b459f86621683f9731fb6a7d070819dc379840e8ef52f62bb1c68942291'
	'sha256:d87b9c73d82438f927d7d377b84eaafb531fb814a18739d34938188e097e3aa7'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	cd "${srcdir}"

	mkdir -p "${srcdir}/extracted"
	ar x balena-etcher.deb
	tar -xf data.tar.* -C "${srcdir}/extracted"

	install -dm755 "${pkgdir}/usr/lib"
	cp -a "${srcdir}/extracted/usr/lib/balena-etcher" "${pkgdir}/usr/lib/"
	chmod 4755 "${pkgdir}/usr/lib/balena-etcher/chrome-sandbox"
	chmod 0755 \
		"${pkgdir}/usr/lib/balena-etcher/balena-etcher" \
		"${pkgdir}/usr/lib/balena-etcher/resources/etcher-util"

	# Upstream's own "balenaEtcher" symlink points at a GitHub Actions build
	# path that doesn't exist on the installed system; keep the name other
	# tooling might expect, but retarget it to the local binary.
	ln -sfn balena-etcher "${pkgdir}/usr/lib/balena-etcher/balenaEtcher"
	install -dm755 "${pkgdir}/usr/bin"
	ln -sfn ../lib/balena-etcher/balena-etcher \
		"${pkgdir}/usr/bin/balena-etcher"

	# Upstream's .desktop ships no StartupWMClass at all, but the real
	# window's WM_CLASS (confirmed with xprop against a real running
	# instance) is "balenaEtcher" (camelCase), not "balena-etcher" like
	# Icon= - without this line the desktop shell can't match the running
	# window back to this .desktop entry, so the taskbar/dock shows no
	# icon even though the launcher icon works fine.
	sed -i '/^\[Desktop Entry\]$/a StartupWMClass=balenaEtcher' \
		"${srcdir}/extracted/usr/share/applications/balena-etcher.desktop"
	install -Dm644 \
		"${srcdir}/extracted/usr/share/applications/balena-etcher.desktop" \
		"${pkgdir}/usr/share/applications/balena-etcher.desktop"
	install -Dm644 \
		"${srcdir}/extracted/usr/share/pixmaps/balena-etcher.png" \
		"${pkgdir}/usr/share/pixmaps/balena-etcher.png"

	# The AppStream component claims this desktop id; make the build
	# fail here rather than shipping a component nothing can launch.
	test -f "${pkgdir}/usr/share/applications/balena-etcher.desktop"
	install -Dm644 "${srcdir}/balena-etcher.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/balena-etcher.metainfo.xml"
	install-license LICENSE "balena-etcher/LICENSE"
	install-license \
		"${srcdir}/extracted/usr/share/doc/balena-etcher/copyright" \
		"balena-etcher/copyright"
	install-license \
		"${srcdir}/extracted/usr/lib/balena-etcher/LICENSES.chromium.html" \
		"balena-etcher/LICENSES.chromium.html"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/balena-etcher.metainfo.xml" \
		"/usr/lib/balena-etcher/**/*" \
		"/usr/share/pixmaps/balena-etcher.png"
}
