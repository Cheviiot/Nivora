name='balena-etcher'
version='2.1.9'
release=6

summary='Write OS images to USB drives and SD cards'
summary_ru='Запись образов систем на USB-накопители и SD-карты'
desc='balenaEtcher writes operating system images to USB drives and SD cards and validates the written data.'
desc_ru='balenaEtcher записывает образы операционных систем на USB-накопители и SD-карты и проверяет записанные данные.'
group='System/Configuration/Hardware'
homepage='https://etcher.balena.io/'
maintainer='Balena Ltd. <hello@balena.io>'

license=('Apache-2.0')

appstream_app_id='balena-etcher'
appstream_name='balenaEtcher'

architectures=('amd64')
compatible_with=('altlinux_p11')
disable_network=1

provides=()
replaces=('balena-etcher')
conflicts=()

auto_reqprov_method='dirty'
auto_req=1
auto_prov=0

# Etcher uses polkit for disk access. Keep dynamically loaded desktop libraries explicit.
deps=(
	'libnotify' 'libXtst' 'xdg-utils' 'fontconfig' 'libfreetype'
	'libgdk-pixbuf' 'liblzma' 'libXcursor' 'libXi' 'libXrender'
	'libXScrnSaver' 'polkit'
)
build_deps=('binutils')

sources=(
	"https://github.com/balena-io/etcher/releases/download/v${version}/balena-etcher_${version}_amd64.deb?~archive=false&~name=balena-etcher.deb"
	"https://raw.githubusercontent.com/balena-io/etcher/v${version}/LICENSE?~archive=false&~name=LICENSE"
	'local:///balena-etcher.metainfo.xml?nivora=balena-etcher'
)
checksums=(
	'sha256:7e0d0e0986e5d0f3d9c03a4c0004f9891235150e0da99fa0bc332d8c03f1a4c0'
	'sha256:39445b459f86621683f9731fb6a7d070819dc379840e8ef52f62bb1c68942291'
	'sha256:3fecd7734f1aa2cf6ffddb2a47963c1556fe8cdf9cb7288803da1377f4908e49'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	unpack_dir="$(mktemp -d "${srcdir}/etcher-unpack.XXXXXX")" || return 1
	cd "${unpack_dir}" || return 1
	ar x "${srcdir}/balena-etcher.deb" || return 1
	tar -xf data.tar.* || return 1

	app_dir="${pkgdir}/usr/lib/balena-etcher"
	install -dm755 "${pkgdir}/usr/lib" "${pkgdir}/usr/bin"
	mv -T usr/lib/balena-etcher "${app_dir}" || return 1
	chmod 4755 "${app_dir}/chrome-sandbox"
	chmod 755 "${app_dir}/balena-etcher" "${app_dir}/resources/etcher-util"
	# Upstream's balenaEtcher symlink points to its CI workspace.
	ln -sfn balena-etcher "${app_dir}/balenaEtcher"
	ln -sfn ../lib/balena-etcher/balena-etcher "${pkgdir}/usr/bin/balena-etcher"

	# Match the case-sensitive WM_CLASS used by the running window.
	desktop_file="${pkgdir}/usr/share/applications/balena-etcher.desktop"
	install -Dm644 usr/share/applications/balena-etcher.desktop "${desktop_file}"
	sed -i '/^\[Desktop Entry\]$/a StartupWMClass=balenaEtcher' "${desktop_file}"
	install -Dm644 usr/share/pixmaps/balena-etcher.png "${pkgdir}/usr/share/pixmaps/balena-etcher.png"
	install -Dm644 "${srcdir}/balena-etcher.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/balena-etcher.metainfo.xml"

	install-license "${srcdir}/LICENSE" "balena-etcher/LICENSE"
	install-license "${unpack_dir}/usr/share/doc/balena-etcher/copyright" "balena-etcher/copyright"
	install-license "${app_dir}/LICENSES.chromium.html" "balena-etcher/LICENSES.chromium.html"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/balena-etcher.metainfo.xml" \
		"/usr/lib/balena-etcher/**/*" \
		"/usr/share/pixmaps/balena-etcher.png"
}
