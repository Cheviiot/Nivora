package() {
	unpack_dir="$(mktemp -d "${srcdir}/chatgpt-unpack.XXXXXX")" || return 1
	cd "${unpack_dir}" || return 1
	ar x "${srcdir}/chatgpt.deb" || return 1
	# Both architectures use mutable /latest/ URLs. Verify the pinned payload before staging it.
	tar -xOf control.tar.* ./control >deb-control || return 1
	if ! grep -Fxq "Version: ${version}" deb-control || ! grep -Fxq "Architecture: ${ARCH}" deb-control; then
		echo "Expected ChatGPT ${version} for ${ARCH}, got these DEB fields:" >&2
		grep -E '^(Version|Architecture):' deb-control >&2
		return 1
	fi
	tar -xf data.tar.* || return 1

	# The upstream AppArmor profile grants user namespaces to this exact executable.
	grep -Fq '"/usr/lib/chatgpt/ChatGPT"' etc/apparmor.d/chatgpt || return 1
	install -Dm644 etc/apparmor.d/chatgpt "${pkgdir}/etc/apparmor.d/chatgpt"
	app_dir="${pkgdir}/usr/lib/chatgpt"
	install -dm755 "${pkgdir}/usr/lib" "${pkgdir}/usr/bin"
	mv -T usr/lib/chatgpt "${app_dir}" || return 1
	python3 "${srcdir}/patch-documents-dir.py" "${app_dir}/resources/app.asar" || return 1
	chmod 755 \
		"${app_dir}/ChatGPT" \
		"${app_dir}/codex-launcher" \
		"${app_dir}/browser_crashpad_handler"
	ln -sfn /usr/lib/chatgpt/ChatGPT "${pkgdir}/usr/bin/chatgpt"

	# The p11 glibc runtime cannot load musl addons. Unused Qt shims pull both Qt runtimes into the RPM.
	find "${app_dir}" -type f \( -name '*.musl.node' -o -path '*-musl/*.node' \) -delete
	rm -f "${app_dir}/libqt5_shim.so" "${app_dir}/libqt6_shim.so"

	desktop_file="${pkgdir}/usr/share/applications/chatgpt.desktop"
	install -Dm644 usr/share/applications/chatgpt.desktop "${desktop_file}"
	sed -i \
		-e '/^\[Desktop Entry\]$/a StartupWMClass=Chatgpt' \
		-e '0,/^Exec=/{s|^Exec=.*|Exec=/usr/bin/chatgpt %U|}' \
		"${desktop_file}"
	install -Dm644 "${srcdir}/com.openai.chatgpt.png" "${pkgdir}/usr/share/pixmaps/chatgpt.png"
	install -Dm644 "${srcdir}/com.openai.chatgpt.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/com.openai.chatgpt.metainfo.xml"

	install-license "${srcdir}/LICENSE" "chatgpt/LICENSE.nivora"
	install-license "${app_dir}/LICENSES.chromium.html" "chatgpt/LICENSES.chromium.html"
}

files() {
	files-find "/usr/lib/chatgpt/**/*"
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
