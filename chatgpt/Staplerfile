# auto_req covers the real DT_NEEDED (readelf -d confirmed against the
# installed ChatGPT binary). The rest stays explicit: xz-utils and the
# trash-integration alternative are subprocess tools, xdg-utils likewise,
# and libnotify/libsecret-equivalent/libXtst/libXScrnSaver are dlopen'd by
# Chromium's Linux integration layer, same pattern as every other Electron
# package in this catalog. mesa-vulkan-drivers is resolved by the Vulkan
# ICD loader at runtime, not the dynamic linker. libusb is kept explicit
# even though device-kit-oai's native addons (node-hid, serialport) do
# link it directly, since USB device access is easy to silently break and
# not worth the risk of relying purely on auto_req's soname resolution.
deps=('libnotify' 'libsecret' 'libXtst' 'libXScrnSaver' 'xdg-utils' 'gvfs' 'mesa-dri-drivers' 'libusb' 'xz')

