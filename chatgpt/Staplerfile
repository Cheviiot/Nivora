package() {
	cd "${srcdir}"

	mkdir -p "${srcdir}/extracted"
	ar x chatgpt.deb
	tar -xf data.tar.* -C "${srcdir}/extracted"

	# Keep the upstream executable path: the shipped AppArmor profile grants
	# user namespaces specifically to /usr/lib/chatgpt/ChatGPT.
	install -dm755 "${pkgdir}/usr/lib"
	cp -a "${srcdir}/extracted/usr/lib/chatgpt" "${pkgdir}/usr/lib/chatgpt"
	chmod 755 \
		"${pkgdir}/usr/lib/chatgpt/ChatGPT" \
		"${pkgdir}/usr/lib/chatgpt/codex-launcher" \
		"${pkgdir}/usr/lib/chatgpt/browser_crashpad_handler"

	# musl-linked native addon variants (node-hid, serialport) are dead
	# weight on ALT's glibc - Node's own platform detection picks the
	# glibc build at runtime, but rpm's dependency scanner would otherwise
	# read their musl-style unversioned libc.so NEEDED entry and turn it
	# into an unsatisfiable Requires during RPM dependency scanning.
	find "${pkgdir}/usr/lib/chatgpt" -type f \
		\( -name '*.musl.node' -o -path '*-musl/*.node' \) -delete

	# libqt5_shim.so/libqt6_shim.so are bundled but referenced nowhere in
	# the payload (confirmed: no string reference in the main binary, no
	# hit anywhere under grep -r across the whole extracted tree) - each
	# links a full Qt5 or Qt6 runtime, which auto_req would otherwise turn
	# into a hard Requires forcing every user, including plain GTK/GNOME
	# desktops, to install two entire parallel Qt toolkits for a feature
	# nothing in this build actually exercises.
	rm -f \
		"${pkgdir}/usr/lib/chatgpt/libqt5_shim.so" \
		"${pkgdir}/usr/lib/chatgpt/libqt6_shim.so"

	install -dm755 "${pkgdir}/usr/bin"
	ln -sfn /usr/lib/chatgpt/ChatGPT "${pkgdir}/usr/bin/chatgpt"

	# Upstream's .desktop ships no StartupWMClass at all, but the real
	# window's WM_CLASS (confirmed with xprop against a real running
	# instance) is "Chatgpt", not "chatgpt" like Icon= - without this line
	# the desktop shell can't match the running window back to this
	# .desktop entry, so the taskbar/dock shows no icon even though the
	# launcher icon works fine.
	sed -i \
		-e '/^\[Desktop Entry\]$/a StartupWMClass=Chatgpt' \
		-e '0,/^Exec=/{s|^Exec=.*|Exec=/usr/bin/chatgpt %U|}' \
		"${srcdir}/extracted/usr/share/applications/chatgpt.desktop"
	install-desktop "${srcdir}/extracted/usr/share/applications/chatgpt.desktop"

	install -Dm644 com.openai.chatgpt.png "${pkgdir}/usr/share/pixmaps/chatgpt.png"

	# Ships its own AppArmor profile granting unprivileged userns instead of
	# a setuid chrome-sandbox helper (there isn't one in this build). Fail the
	# build if upstream changes the profile path without the recipe following it.
	grep -Fq '"/usr/lib/chatgpt/ChatGPT"' \
		"${srcdir}/extracted/etc/apparmor.d/chatgpt"
	install -Dm644 "${srcdir}/extracted/etc/apparmor.d/chatgpt" \
		"${pkgdir}/etc/apparmor.d/chatgpt"

	# The AppStream component claims this desktop id; make the build
	# fail here rather than shipping a component nothing can launch.
	test -f "${pkgdir}/usr/share/applications/chatgpt.desktop"
	# Upstream ships its own AppStream document, with component id
	# com.openai.chatgpt launching chatgpt.desktop. It is installed as-is
	# rather than replaced by a generated one.
	install -Dm644 \
		"${srcdir}/extracted/usr/share/metainfo/com.openai.chatgpt.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/com.openai.chatgpt.metainfo.xml"
	install-license LICENSE "chatgpt/LICENSE.nivora"
	install -Dm644 "${srcdir}/extracted/usr/lib/chatgpt/LICENSES.chromium.html" \
		"${pkgdir}/usr/share/licenses/chatgpt/LICENSES.chromium.html"
}

files() {
	files-find "/usr/lib/chatgpt/**/*"
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/com.openai.chatgpt.metainfo.xml" \
		"/usr/share/pixmaps/chatgpt.png" \
		"/etc/apparmor.d/chatgpt"
}
