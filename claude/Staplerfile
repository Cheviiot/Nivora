group='Development/Tools'
desc='Desktop application for Claude.ai'
desc_ru='Десктопное приложение для Claude.ai'
homepage='https://code.claude.com/docs/en/desktop-quickstart'
maintainer='Anthropic PBC <support@anthropic.com>'

architectures=('amd64' 'arm64')
compatible_with=('altlinux')

license=('LicenseRef-proprietary')

appstream_app_id='com.anthropic.Claude'
appstream_name='Claude'
nonfree=1
nonfree_msg='Claude Desktop является проприетарным приложением Anthropic. Использование Claude, Claude Code, учетной записи, подписки, сетевых функций и моделей регулируется условиями Anthropic.'
nonfree_url='https://www.anthropic.com/legal/consumer-terms'

provides=()
replaces=('claude' 'claude-desktop')
conflicts=()

auto_reqprov_method="dirty"
auto_req=1
auto_prov=0
disable_network=1

# auto_req covers everything readelf -d confirms as real DT_NEEDED of the
# installed claude-desktop binary (gtk3, nss, at-spi2, gbm, xcb, glibc, ...).
# The rest stays explicit because it never shows up in that scan: xdg-utils
# and xdg-desktop-portal(-gtk) are a subprocess tool and a D-Bus portal
# service, not linked libraries; libnotify/libsecret/libXtst/libuuid are
# all loaded by Chromium's Linux integration layer via dlopen() rather than
# linked, so the app runs without them but loses notifications, keyring
# integration and global input handling - keep them hard deps for the real
# functionality, not the silently degraded fallback.
deps=('libnotify' 'xdg-utils' 'libsecret' 'libXtst' 'libuuid' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk')

opt_deps=('libalsa' 'libappindicator-gtk3' 'ca-certificates' 'gnome-keyring' 'qemu-system-x86' 'virtiofsd')

build_deps=('binutils' 'python3')

sources=(
