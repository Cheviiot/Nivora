package() {
	cd "${srcdir}"

	mkdir -p "${srcdir}/extracted"
	ar x claude-desktop.deb
	tar -xf data.tar.* -C "${srcdir}/extracted"

	install -dm755 "${pkgdir}/usr/lib"
	cp -a "${srcdir}/extracted/usr/lib/claude-desktop" "${pkgdir}/usr/lib/"
	chmod 4755 "${pkgdir}/usr/lib/claude-desktop/chrome-sandbox"
	chmod 755 \
		"${pkgdir}/usr/lib/claude-desktop/claude-desktop" \
		"${pkgdir}/usr/lib/claude-desktop/resources/chrome-native-host" \
		"${pkgdir}/usr/lib/claude-desktop/resources/cowork-linux-helper" \
		"${pkgdir}/usr/lib/claude-desktop/resources/virtiofsd"

	# Keeps Claude's own tray glyph shape, only recolors it.
	for icon_name in TrayIconLinux.png TrayIconLinux-Dark.png; do
		install -Dm644 "${srcdir}/claude-tray-orange.png" \
			"${pkgdir}/usr/lib/claude-desktop/resources/${icon_name}"
	done

	install -dm755 "${pkgdir}/usr/share"
	cp -a "${srcdir}/extracted/usr/share/applications" "${pkgdir}/usr/share/"
	cp -a "${srcdir}/extracted/usr/share/icons" "${pkgdir}/usr/share/"

	desktop_file="$(find "${pkgdir}/usr/share/applications" -maxdepth 1 -type f -name "*.desktop" | head -1)"
	[[ -n "${desktop_file}" ]] || {
		echo "Claude desktop file not found" >&2
		return 1
	}
	sed -i \
		-e '0,/^Name=/{s/^Name=.*/Name=Claude\nName[ru]=Claude/}' \
		-e 's/^Categories=.*/Categories=Development;/' \
		"${desktop_file}"

	install -dm755 "${pkgdir}/usr/bin"
	ln -sfn /usr/lib/claude-desktop/claude-desktop "${pkgdir}/usr/bin/claude-desktop"

	install -dm755 "${pkgdir}/usr/share/licenses/claude"
	# The AppStream component claims this desktop id; make the build
	# fail here rather than shipping a component nothing can launch.
	test -f "${pkgdir}/usr/share/applications/com.anthropic.Claude.desktop"
	install -Dm644 "${srcdir}/com.anthropic.Claude.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/com.anthropic.Claude.metainfo.xml"
	install-license "${srcdir}/LICENSE" "claude/LICENSE.nivora"
	install -Dm644 "${srcdir}/extracted/usr/share/doc/claude-desktop/copyright" \
		"${pkgdir}/usr/share/licenses/claude/copyright"
	install -Dm644 "${srcdir}/extracted/usr/lib/claude-desktop/LICENSES.chromium.html" \
		"${pkgdir}/usr/share/licenses/claude/LICENSES.chromium.html"
	install -Dm644 "${srcdir}/extracted/usr/lib/claude-desktop/resources/virtiofsd.LICENSE-APACHE" \
		"${pkgdir}/usr/share/licenses/claude/virtiofsd.LICENSE-APACHE"
	install -Dm644 "${srcdir}/extracted/usr/lib/claude-desktop/resources/virtiofsd.LICENSE-BSD-3-Clause" \
		"${pkgdir}/usr/share/licenses/claude/virtiofsd.LICENSE-BSD-3-Clause"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/com.anthropic.Claude.metainfo.xml" \
		"/usr/lib/claude-desktop/**/*" \
		"/usr/share/icons/hicolor/*/apps/claude-desktop.png"
}
