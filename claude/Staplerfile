package() {
	unpack_dir="$(mktemp -d "${srcdir}/claude-unpack.XXXXXX")" || return 1
	cd "${unpack_dir}" || return 1
	ar x "${srcdir}/claude-desktop.deb" || return 1
	tar -xf data.tar.* || return 1

	app_dir="${pkgdir}/usr/lib/claude-desktop"
	install -dm755 "${pkgdir}/usr/lib" "${pkgdir}/usr/bin"
	mv -T usr/lib/claude-desktop "${app_dir}" || return 1
	chmod 4755 "${app_dir}/chrome-sandbox"
	chmod 755 \
		"${app_dir}/claude-desktop" \
		"${app_dir}/resources/chrome-native-host" \
		"${app_dir}/resources/cowork-linux-helper" \
		"${app_dir}/resources/virtiofsd"
	ln -sfn /usr/lib/claude-desktop/claude-desktop "${pkgdir}/usr/bin/claude-desktop"
	for icon_name in TrayIconLinux.png TrayIconLinux-Dark.png; do
		install -Dm644 "${srcdir}/claude-tray-orange.png" "${app_dir}/resources/${icon_name}"
	done

	install -dm755 "${pkgdir}/usr/share"
	cp -a usr/share/applications usr/share/icons "${pkgdir}/usr/share/"
	sed -i \
		-e '0,/^Name=/{s/^Name=.*/Name=Claude\nName[ru]=Claude/}' \
		-e 's/^Categories=.*/Categories=Development;/' \
		"${pkgdir}/usr/share/applications/com.anthropic.Claude.desktop" || return 1
	install -Dm644 "${srcdir}/com.anthropic.Claude.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/com.anthropic.Claude.metainfo.xml"

	install-license "${srcdir}/LICENSE" "claude/LICENSE.nivora"
	install-license "${unpack_dir}/usr/share/doc/claude-desktop/copyright" "claude/copyright"
	install-license "${app_dir}/LICENSES.chromium.html" "claude/LICENSES.chromium.html"
	for license_file in virtiofsd.LICENSE-APACHE virtiofsd.LICENSE-BSD-3-Clause; do
		install-license "${app_dir}/resources/${license_file}" "claude/${license_file}"
	done
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/com.anthropic.Claude.metainfo.xml" \
		"/usr/lib/claude-desktop/**/*" \
		"/usr/share/icons/hicolor/*/apps/claude-desktop.png"
}
