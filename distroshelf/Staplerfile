name='distroshelf'
version=1.5.2
release=1
summary='GTK4 client for managing Distrobox containers'
summary_ru='GTK4-клиент для управления контейнерами Distrobox'
group='System/Configuration/Other'
desc='DistroShelf is a GTK4/libadwaita graphical interface for creating, managing and entering Distrobox containers, with support for exporting apps and binaries to the host.'
desc_ru='DistroShelf — графический интерфейс на GTK4/libadwaita для создания, управления и входа в контейнеры Distrobox, с поддержкой экспорта приложений и бинарников на хост.'
homepage='https://github.com/ranfdev/DistroShelf'
maintainer='ranfdev <https://github.com/ranfdev>'

architectures=('amd64')

license=('GPL-3.0-or-later')

provides=()
replaces=('distroshelf')
conflicts=()

deps=()
deps_debian=('libgtk-4-1' 'libadwaita-1-0' 'libvte-2.91-gtk4-0' 'libglib2.0-0')
deps_ubuntu=("${deps_debian[@]}")
deps_fedora=('gtk4' 'libadwaita' 'vte291-gtk4' 'glib2')
deps_arch=('gtk4' 'libadwaita' 'vte4' 'glib2')
deps_opensuse=('gtk4' 'libadwaita' 'vte-gtk4' 'glib2')
deps_altlinux=('libgtk4' 'libadwaita' 'vte3-gtk4' 'glib2')

opt_deps=()
opt_deps_debian=('distrobox')
opt_deps_ubuntu=("${opt_deps_debian[@]}")
opt_deps_fedora=('distrobox')
opt_deps_arch=('distrobox')
opt_deps_opensuse=('distrobox')
opt_deps_altlinux=('distrobox')

build_deps=('meson' 'ninja-build' 'pkgconfig')
build_deps_debian=('build-essential' 'meson' 'ninja-build' 'rustc' 'cargo' 'pkg-config' 'gettext' 'libgtk-4-dev' 'libadwaita-1-dev' 'libvte-2.91-gtk4-dev' 'desktop-file-utils' 'appstream')
build_deps_ubuntu=("${build_deps_debian[@]}")
build_deps_fedora=('gcc' 'gcc-c++' 'meson' 'ninja-build' 'rust' 'cargo' 'pkgconf-pkg-config' 'gettext' 'gtk4-devel' 'libadwaita-devel' 'vte291-gtk4-devel' 'desktop-file-utils' 'appstream')
build_deps_arch=('base-devel' 'meson' 'ninja' 'rust' 'gtk4' 'libadwaita' 'vte4' 'gettext' 'desktop-file-utils' 'appstream')
build_deps_opensuse=('gcc-c++' 'meson' 'ninja' 'rust' 'cargo' 'pkg-config' 'gettext-tools' 'gtk4-devel' 'libadwaita-devel' 'vte-gtk4-devel' 'desktop-file-utils' 'appstream')
build_deps_altlinux=('gcc' 'gcc-c++' 'meson' 'ninja-build' 'rust' 'pkgconfig' 'gettext-tools' 'libgtk4-devel' 'libadwaita-devel' 'vte3-gtk4' 'libvte3-devel' 'desktop-file-utils' 'appstream')

sources=(
	"https://github.com/ranfdev/DistroShelf/releases/download/v${version}/distroshelf-${version}.tar.xz?~archive=false&~name=distroshelf.tar.xz"
	'local:///LICENSE'
)

checksums=(
	'sha256:14483d069335cfdbefb0df541a45e478daf4c9cd3935ae372e217b4c88d3a79d'
	'sha256:b69c62829f176a47dc482840afa24e9d63d66cb963c4b0a994547576d7d2acf4'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	cd "${srcdir}"
	tar --no-same-owner --no-same-permissions -xJf distroshelf.tar.xz
	cd "distroshelf-${version}"

	meson setup builddir --prefix=/usr --buildtype=release -Doffline=true
	meson compile -C builddir
	DESTDIR="${pkgdir}" meson install -C builddir

	install-license COPYING "distroshelf/LICENSE.nivora"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/distroshelf/**/*" \
		"/usr/share/metainfo/com.ranfdev.DistroShelf.metainfo.xml" \
		"/usr/share/icons/hicolor/scalable/apps/com.ranfdev.DistroShelf.svg" \
		"/usr/share/icons/hicolor/symbolic/apps/com.ranfdev.DistroShelf-symbolic.svg" \
		"/usr/share/glib-2.0/schemas/com.ranfdev.DistroShelf.gschema.xml" \
		"/usr/share/dbus-1/services/com.ranfdev.DistroShelf.service" \
		"/usr/share/locale/**/LC_MESSAGES/distroshelf.mo"
}
