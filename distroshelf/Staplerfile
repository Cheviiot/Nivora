name='distroshelf'
version=1.5.2
release=6
summary='GTK4 client for managing Distrobox containers'
summary_ru='GTK4-клиент для управления контейнерами Distrobox'
group='System/Configuration/Other'
desc='DistroShelf is a GTK4/libadwaita graphical interface for creating, managing and entering Distrobox containers, with support for exporting apps and binaries to the host.'
desc_ru='DistroShelf — графический интерфейс на GTK4/libadwaita для создания, управления и входа в контейнеры Distrobox, с поддержкой экспорта приложений и бинарников на хост.'
homepage='https://github.com/ranfdev/DistroShelf'
maintainer='Cheviiot <Cheviiot@users.noreply.github.com>'

architectures=('amd64')
compatible_with=('altlinux')
incompatible_with=('alpine')
disable_network=1

license=('GPL-3.0-or-later')

provides=()
replaces=('distroshelf')
conflicts=()

# The dirty finder covers binary requirements on RPM targets instead of a
# hand-maintained list. FindProvides is intentionally disabled because it is
# a no-op in Stapler v0.1.1 and cannot advertise bundled libraries safely.
# the bundled libvte-2.91-gtk4.so.0 (built by Nivora CI against ALT p11, see
# maintenance.md) has real DT_NEEDED entries (libgnutls, libfribidi,
# libpcre2, libsystemd, libgraphene, libicuuc.so.74/libicudata.so.74, ...)
# that the old 5-package explicit list never listed directly — they only
# worked because gtk4/glib2 happen to pull them in transitively. auto_req
# makes them direct Requires instead, and sidesteps hardcoding an ALT-only
# soname version (libicu74) that could drift the way parsec's libavcodec61
# did.
auto_reqprov_method='dirty'
auto_req=0
auto_req_altlinux=1
auto_prov=0

deps=()
deps_altlinux=('distrobox')

opt_deps=()

build_deps=('binutils')

sources=(
	"https://github.com/Cheviiot/Nivora/releases/download/distroshelf-${version}-linux/distroshelf-${version}-linux-x64.tar.gz?~archive=false&~name=distroshelf.tar.gz"
	'local:///LICENSE?nivora=distroshelf'
)

checksums=(
	'sha256:50a03baa5cc75a9bf95e60043b63d6876d588322b5a0c1188d4e0ae80b377115'
	'sha256:b69c62829f176a47dc482840afa24e9d63d66cb963c4b0a994547576d7d2acf4'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

appstream_app_id='com.ranfdev.DistroShelf'

package() {
	cd "${srcdir}"
	tar --no-same-owner --no-same-permissions -xzf distroshelf.tar.gz
	test -f "${srcdir}/usr/share/applications/com.ranfdev.DistroShelf.desktop"
	test -f "${srcdir}/usr/share/metainfo/com.ranfdev.DistroShelf.metainfo.xml"

	cp -a usr "${pkgdir}/usr"

	install-license LICENSE "distroshelf/LICENSE.nivora"
}

files() {
	files-find "/usr/lib/distroshelf/**/*"
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/distroshelf/**/*" \
		"/usr/share/metainfo/com.ranfdev.DistroShelf.metainfo.xml" \
		"/usr/share/icons/hicolor/scalable/apps/com.ranfdev.DistroShelf.svg" \
		"/usr/share/icons/hicolor/symbolic/apps/com.ranfdev.DistroShelf-symbolic.svg" \
		"/usr/share/glib-2.0/schemas/com.ranfdev.DistroShelf.gschema.xml" \
		"/usr/share/dbus-1/services/com.ranfdev.DistroShelf.service" \
		"/usr/share/locale/**/LC_MESSAGES/distroshelf.mo"
}
