name='github-desktop'
version='3.6.6'
release=4
# Exact commit behind the upstream release-${version} tag. Keeping it
# separate makes a stale pin visible when version is updated.
upstream_commit='8b85519e733fd98a04c178249d2d10fd8f3db19e'
summary='Focus on what matters instead of fighting with Git.'
summary_ru='Сосредоточьтесь на главном вместо борьбы с Git.'
group='Development/Tools'
desc='GitHub Desktop is an open source Electron-based GitHub app. It is written in TypeScript and uses React.'
desc_ru='GitHub Desktop — открытое приложение GitHub на Electron. Написано на TypeScript и использует React.'
homepage='https://github.com/desktop/desktop'
maintainer='Cheviiot <Cheviiot@users.noreply.github.com>'

architectures=('amd64' 'arm64')
compatible_with=('altlinux')

license=('MIT')

appstream_app_id='github-desktop'
appstream_name='GitHub Desktop'
appstream_developer='GitHub'

provides=()
replaces=('github-desktop')
conflicts=()

auto_reqprov_method="dirty"
auto_req=1
auto_prov=0
disable_network=1

# auto_req covers the real DT_NEEDED across the whole payload (readelf -d
# confirmed: the main desktop binary's Chromium stack, plus the bundled
# portable git under resources/app/git/libexec/git-core/ — git itself
# needs zlib, which the old explicit list never named directly, and
# git-remote-http/git-http-fetch/git-http-push/git-imap-send need libcurl.
# The Ubuntu-built network helpers require CURL_OPENSSL_4, which is not a
# portable libcurl symbol ABI (ALT exports CURL_GNUTLS_4 instead). The packaged
# wrapper delegates those four helpers to the system Git installation, while
# the rest of the bundled portable Git remains unchanged.
# The rest stays explicit: ca-certificates is data, git is the *system* git invoked as a
# subprocess by the app itself (a separate thing from the bundled portable
# git above, not detectable by ELF scanning either way), xdg-utils is a
# subprocess tool, and libsecret/libXScrnSaver/libXtst are dlopen'd by
# Chromium like in the rest of the catalog's Electron packages.
deps=('ca-certificates' 'git' 'libsecret' 'libXScrnSaver' 'libXtst' 'xdg-utils')

build_deps=('binutils')

sources=(
