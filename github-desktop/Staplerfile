# On RPM targets, auto_req covers the real DT_NEEDED across the whole payload (readelf -d
# confirmed: the main desktop binary's Chromium stack, plus the bundled
# portable git under resources/app/git/libexec/git-core/ — git itself
# needs zlib, which the old explicit list never named directly, and
# git-remote-http/git-http-fetch/git-http-push/git-imap-send need libcurl.
# The Ubuntu-built network helpers require CURL_OPENSSL_4, which is not a
# portable libcurl symbol ABI (ALT exports CURL_GNUTLS_4 instead). The packaged
# wrapper delegates those four helpers to the system Git installation, while
# the rest of the bundled portable Git remains unchanged.
# The rest stays explicit: ca-certificates is data, git is the *system* git invoked as a
# subprocess by the app itself (a separate thing from the bundled portable
# git above, not detectable by ELF scanning either way), xdg-utils is a
# subprocess tool, and libsecret/libXScrnSaver/libXtst are dlopen'd by
# Chromium like in the rest of the catalog's Electron packages.
deps=()
deps_debian=('ca-certificates' 'git' 'libasound2t64 | libasound2' 'libatk-bridge2.0-0' 'libatk1.0-0' 'libatspi2.0-0' 'libcairo2' 'libcups2' 'libcurl4t64 | libcurl4' 'libdbus-1-3' 'libexpat1' 'libgbm1' 'libglib2.0-0' 'libgtk-3-0' 'libnspr4' 'libnss3' 'libpango-1.0-0' 'libsecret-1-0' 'libudev1' 'libx11-6' 'libxcb1' 'libxcomposite1' 'libxdamage1' 'libxext6' 'libxfixes3' 'libxkbcommon0' 'libxrandr2' 'libxss1' 'libxtst6' 'xdg-utils')
