package() {
	cd "${srcdir}"

	tar -xzf github-desktop.tar.gz
	[[ -x "${srcdir}/github-desktop/desktop" ]]
	actual_upstream_commit="$(cat "${srcdir}/github-desktop/UPSTREAM_COMMIT")"
	[[ "$actual_upstream_commit" == "$upstream_commit" ]]

	install -dm755 "${pkgdir}/opt/github-desktop"
	cp -a "${srcdir}/github-desktop/." "${pkgdir}/opt/github-desktop/"
	chmod 0755 "${pkgdir}/opt/github-desktop/desktop"
	git_core="${pkgdir}/opt/github-desktop/resources/app/git/libexec/git-core"
	for helper in \
		git-http-fetch git-http-push git-imap-send \
		git-remote-http; do
		test -x "${git_core}/${helper}"
		rm -f "${git_core}/${helper}"
		install -m755 github-desktop-git-wrapper "${git_core}/${helper}"
	done
	if [[ -f "${pkgdir}/opt/github-desktop/chrome-sandbox" ]]; then
		chmod 4755 "${pkgdir}/opt/github-desktop/chrome-sandbox"
	fi

	install -dm755 "${pkgdir}/usr/bin"
	ln -sfn /opt/github-desktop/desktop "${pkgdir}/usr/bin/github-desktop"

	install -Dm644 github-desktop.svg \
		"${pkgdir}/usr/share/icons/hicolor/scalable/apps/github-desktop.svg"
	install -Dm644 /dev/stdin \
		"${pkgdir}/usr/share/applications/github-desktop.desktop" <<'EOF'
[Desktop Entry]
Name=GitHub Desktop
Comment=Simple collaboration from your desktop
Comment[ru]=Графический клиент для работы с GitHub
Exec=/usr/bin/github-desktop --protocol-launcher %U
Terminal=false
Type=Application
Icon=github-desktop
Categories=Development;RevisionControl;
MimeType=x-scheme-handler/x-github-desktop-auth;x-scheme-handler/x-github-client;x-scheme-handler/github-mac;
StartupWMClass=desktop
EOF

	# The AppStream component claims this desktop id; make the build
	# fail here rather than shipping a component nothing can launch.
	test -f "${pkgdir}/usr/share/applications/github-desktop.desktop"
	install -Dm644 "${srcdir}/github-desktop.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/github-desktop.metainfo.xml"
	install-license LICENSE "github-desktop/LICENSE"
	install -Dm644 "${srcdir}/github-desktop/LICENSE" \
		"${pkgdir}/usr/share/licenses/github-desktop/LICENSE.electron.txt"
	install -Dm644 "${srcdir}/github-desktop/LICENSES.chromium.html" \
		"${pkgdir}/usr/share/licenses/github-desktop/LICENSES.chromium.html"
}

files() {
	files-find "/opt/github-desktop/**/*"
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/github-desktop.metainfo.xml" \
	files-find "/usr/share/icons/hicolor/*/apps/github-desktop.svg"
}
