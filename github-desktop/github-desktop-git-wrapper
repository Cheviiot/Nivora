#!/bin/sh
set -eu

case "$0" in
/*) helper="$0" ;;
*) helper="$(command -v -- "$0")" ;;
esac
helper_name="${helper##*/}"
case "$helper_name" in
git-remote-https | git-remote-ftp | git-remote-ftps)
    helper_name='git-remote-http'
    ;;
esac

# The portable Git helpers are built on Ubuntu and require its libcurl symbol
# ABI. Delegate only the network helpers to the system Git installation so each
# supported distribution uses helpers built for its own libcurl. The bundled
# Git binary and all non-network helpers remain untouched.
unset GIT_EXEC_PATH
system_exec_path="$(/usr/bin/git --exec-path)"
system_helper="${system_exec_path}/${helper_name}"
[ -x "$system_helper" ] || {
    printf 'github-desktop: system Git helper is missing: %s\n' \
        "$system_helper" >&2
    exit 127
}

exec "$system_helper" "$@"
