+void test_parse_info_json_modern_developer () {
+    var json = """[{"repository":"nivora","name":"anidesk","appstream":{
+        "developer":{"id":"io.github.thedesconnet","name":{"C":"Modern Developer"}},
+        "developer_name":{"C":"Legacy Developer"}
+    }}]""";
+    try {
+        var result = Stplr.parse_info_json (json);
+        assert_cmpstr (result[0].developer_name, CompareOperator.EQ, "Modern Developer");
+    } catch (Error e) {
+        assert_not_reached ();
+    }
+}
+
+void test_parse_info_json_localized_developer () {
+    string? previous_language = Environment.get_variable ("LANGUAGE");
+    Environment.set_variable ("LANGUAGE", "ru", true);
+    var json = """[{"repository":"nivora","name":"anidesk","appstream":{
+        "developer":{"id":"io.github.thedesconnet","name":{"C":"Developer","ru":"Разработчик"}}
+    }}]""";
+    try {
+        var result = Stplr.parse_info_json (json);
+        assert_cmpstr (result[0].developer_name, CompareOperator.EQ, "Разработчик");
+    } catch (Error e) {
+        assert_not_reached ();
+    }
+    if (previous_language == null)
+        Environment.unset_variable ("LANGUAGE");
+    else
+        Environment.set_variable ("LANGUAGE", previous_language, true);
+}
+
+void test_parse_info_json_developer_fallback () {
+    string[] inputs = {
+        """[{"repository":"nivora","name":"chatgpt","appstream":{
+            "developer_name":{"C":"Legacy Developer"}
+        }}]""",
+        """[{"repository":"nivora","name":"chatgpt","appstream":{
+            "developer":{"id":"com.example","name":{}},
+            "developer_name":{"C":"Legacy Developer"}
+        }}]""",
+        """[{"repository":"nivora","name":"chatgpt","appstream":{
+            "developer":null,"developer_name":{"C":"Legacy Developer"}
+        }}]"""
+    };
+    foreach (var json in inputs) {
+        try {
+            var result = Stplr.parse_info_json (json);
+            assert_cmpstr (result[0].developer_name, CompareOperator.EQ, "Legacy Developer");
+        } catch (Error e) {
+            assert_not_reached ();
+        }
+    }
+}
