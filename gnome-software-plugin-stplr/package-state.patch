+void test_package_versions () {
+    try {
+        var found = Stplr.search_by_keywords ({ "editor" });
+        assert (found.length == 3);
+        assert (found[0].state == Stplr.State.UPDATABLE);
+        assert_cmpstr (found[0].version, CompareOperator.EQ, "1.0-1");
+        assert_cmpstr (found[0].update_version, CompareOperator.EQ, "2.0-1");
+        assert (found[1].state == Stplr.State.AVAILABLE);
+        assert_cmpstr (found[1].version, CompareOperator.EQ, "3.0-1");
+        assert (found[2].state == Stplr.State.INSTALLED);
+        assert_cmpstr (found[2].version, CompareOperator.EQ, "1.5-1");
+
+        var installed = Stplr.search_installed ();
+        assert (installed.length == 2);
+        foreach (var app in installed) {
+            if (app.stplr_id == "Nivora/editor") {
+                assert (app.state == Stplr.State.UPDATABLE);
+                assert_cmpstr (app.version, CompareOperator.EQ, "1.0-1");
+                assert_cmpstr (app.update_version, CompareOperator.EQ, "2.0-1");
+            } else {
+                assert_cmpstr (app.stplr_id, CompareOperator.EQ, "other/writer");
+                assert (app.state == Stplr.State.INSTALLED);
+                assert_null (app.update_version);
+            }
+        }
+    } catch (Error e) {
+        error ("%s", e.message);
+    }
+}
+
 void main (string[] args) {
     Test.init (ref args);
+    Test.add_func ("/stplr/app/package-versions", test_package_versions);
 
     Test.add_func ("/stplr/description/plain_text", test_format_description_plain_text);
     Test.add_func ("/stplr/description/paragraph", test_format_description_paragraph);
