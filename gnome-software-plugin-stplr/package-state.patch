+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <stdio.h>
+#include <string.h>
+
+static void
+record(const char *repo, const char *name, const char *version, const char *update)
+{
+	printf("%s\037%s\037%s\037org.example.Editor\037Editor\037Editor\037Editor%s\036\n",
+	       repo, name, version, update);
+}
+
+int
+main(int argc, char **argv)
+{
+	if (argc < 3)
+		return 1;
+	if (strcmp(argv[1], "search") == 0) {
+		record("Nivora", "editor", "2.0-1", "");
+		record("other", "editor", "3.0-1", "");
+		record("other", "writer", "3.0-1", "");
+	} else if (strcmp(argv[1], "list") == 0 && strcmp(argv[2], "-I") == 0) {
+		record("Nivora", "editor", "1.0-1", "");
+		record("other", "writer", "1.5-1", "");
+	} else if (strcmp(argv[1], "list") == 0 && strcmp(argv[2], "-U") == 0) {
+		record("Nivora", "editor", "2.0-1", "\0371.0-1\0372.0-1");
+	} else if (strcmp(argv[1], "repo") != 0 || strcmp(argv[2], "list") != 0) {
+		return 1;
+	}
+	return 0;
+}
