+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "stplr-app-state.h"
+
+/* Queries and package transactions run on different worker threads. */
+static GMutex state_mutex;
+
+void
+stplr_app_apply_snapshot(GsApp *app, GsAppState state, const gchar *version,
+                         const gchar *update_version, gint64 query_started)
+{
+	g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&state_mutex);
+	const gint64 *finished = g_object_get_data(G_OBJECT(app), "stplr-transaction-finished");
+
+	if (finished != NULL && *finished >= query_started)
+		return;
+
+	switch (gs_app_get_state(app)) {
+	case GS_APP_STATE_UNKNOWN:
+	case GS_APP_STATE_AVAILABLE:
+	case GS_APP_STATE_INSTALLED:
+	case GS_APP_STATE_UPDATABLE_LIVE:
+		break;
+	default:
+		/* GNOME Software may already have queued or started an operation. */
+		return;
+	}
+
+	if (g_strcmp0(gs_app_get_version(app), version) != 0)
+		gs_app_set_version(app, version);
+	if (g_strcmp0(gs_app_get_update_version(app), update_version) != 0)
+		gs_app_set_update_version(app, update_version);
+	gs_app_set_state(app, state);
+}
+
+void
+stplr_app_begin_transaction(GsApp *app, GsAppState state)
+{
+	g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&state_mutex);
+	gs_app_set_state(app, state);
+}
+
+void
+stplr_app_finish_transaction(GsApp *app, gboolean success)
+{
+	g_autoptr(GMutexLocker) locker = g_mutex_locker_new(&state_mutex);
+	gint64 *finished = g_new(gint64, 1);
+
+	*finished = g_get_monotonic_time();
+	g_object_set_data_full(G_OBJECT(app), "stplr-transaction-finished", finished, g_free);
+
+	if (!success) {
+		gs_app_set_state_recover(app);
+		return;
+	}
+
+	/* After a removal the card shows the version available to reinstall. */
+	if (gs_app_get_update_version(app) != NULL) {
+		gs_app_set_version(app, gs_app_get_update_version(app));
+		gs_app_set_update_version(app, NULL);
+	}
+	gs_app_set_state(app, gs_app_get_state(app) == GS_APP_STATE_REMOVING
+	                      ? GS_APP_STATE_AVAILABLE : GS_APP_STATE_INSTALLED);
+}
