@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "../stplr-app-state.h"
+
+static void
+assert_package(GsApp *app, GsAppState state, const gchar *version, const gchar *update)
+{
+	g_assert_cmpint(gs_app_get_state(app), ==, state);
+	g_assert_cmpstr(gs_app_get_version(app), ==, version);
+	g_assert_cmpstr(gs_app_get_update_version(app), ==, update);
+}
+
+static void
+test_package_state(void)
+{
+	g_autoptr(GsApp) app = gs_app_new("org.example.Editor");
+	gint64 started = g_get_monotonic_time();
+
+	/* Reopening a card after an install or removal in the terminal. */
+	stplr_app_apply_snapshot(app, GS_APP_STATE_AVAILABLE, "1.0-1", NULL, started);
+	stplr_app_apply_snapshot(app, GS_APP_STATE_INSTALLED, "1.0-1", NULL, started);
+	assert_package(app, GS_APP_STATE_INSTALLED, "1.0-1", NULL);
+	stplr_app_apply_snapshot(app, GS_APP_STATE_AVAILABLE, "1.0-1", NULL, started);
+	assert_package(app, GS_APP_STATE_AVAILABLE, "1.0-1", NULL);
+
+	stplr_app_apply_snapshot(app, GS_APP_STATE_INSTALLED, "1.0-1", NULL, started);
+	stplr_app_apply_snapshot(app, GS_APP_STATE_UPDATABLE_LIVE, "1.0-1", "2.0-1", started);
+	assert_package(app, GS_APP_STATE_UPDATABLE_LIVE, "1.0-1", "2.0-1");
+
+	stplr_app_begin_transaction(app, GS_APP_STATE_INSTALLING);
+	stplr_app_apply_snapshot(app, GS_APP_STATE_AVAILABLE, "2.0-1", NULL, started);
+	assert_package(app, GS_APP_STATE_INSTALLING, "1.0-1", "2.0-1");
+	stplr_app_finish_transaction(app, FALSE);
+	assert_package(app, GS_APP_STATE_UPDATABLE_LIVE, "1.0-1", "2.0-1");
+
+	stplr_app_begin_transaction(app, GS_APP_STATE_INSTALLING);
+	stplr_app_finish_transaction(app, TRUE);
+	stplr_app_apply_snapshot(app, GS_APP_STATE_UPDATABLE_LIVE, "1.0-1", "2.0-1", started);
+	assert_package(app, GS_APP_STATE_INSTALLED, "2.0-1", NULL);
+
+	stplr_app_apply_snapshot(app, GS_APP_STATE_UPDATABLE_LIVE, "2.0-1", "3.0-1", G_MAXINT64);
+	stplr_app_apply_snapshot(app, GS_APP_STATE_INSTALLED, "3.0-1", NULL, G_MAXINT64);
+	assert_package(app, GS_APP_STATE_INSTALLED, "3.0-1", NULL);
+
+	stplr_app_begin_transaction(app, GS_APP_STATE_REMOVING);
+	stplr_app_apply_snapshot(app, GS_APP_STATE_INSTALLED, "2.0-1", NULL, G_MAXINT64);
+	assert_package(app, GS_APP_STATE_REMOVING, "3.0-1", NULL);
+	stplr_app_finish_transaction(app, TRUE);
+	assert_package(app, GS_APP_STATE_AVAILABLE, "3.0-1", NULL);
+}
+
+int
+main(int argc, char **argv)
+{
+	g_test_init(&argc, &argv, NULL);
+	g_test_add_func("/stplr/app/package-state", test_package_state);
+	return g_test_run();
+}
