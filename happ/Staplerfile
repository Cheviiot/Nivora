package() {
	cd "${srcdir}" || return 1
	extracted="${srcdir}/happ-extracted"
	share="${extracted}/usr/share"
	mkdir -p "${extracted}"
	ar x happ.deb || return 1
	tar -xf data.tar.* -C "${extracted}" || return 1

	cp -a "${extracted}/opt" "${pkgdir}/opt" || return 1
	python3 patch-tray-icons.py "${pkgdir}/opt/happ/bin/Happ" \
		tray-idle.svg tray-connected.svg || return 1
	install -Dm755 happ-launcher "${pkgdir}/usr/bin/happ"
	install-systemd "${extracted}/etc/systemd/system/happd.service"

	sed -i 's|^Exec=/opt/happ/bin/Happ|Exec=/usr/bin/happ|' \
		"${share}/applications/Happ.desktop" || return 1
	install-desktop "${share}/applications/Happ.desktop"
	test -f "${pkgdir}/usr/share/applications/Happ.desktop" || return 1
	python3 render-desktop-icon.py "${share}/icons/hicolor/256x256/apps/happ.png" \
		"${pkgdir}/usr/share/icons/hicolor/512x512/apps/happ.png" || return 1
	install -Dm644 "${share}/mime/packages/happ-mime.xml" \
		"${pkgdir}/usr/share/mime/packages/happ-mime.xml"
	install -Dm644 Happ.metainfo.xml "${pkgdir}/usr/share/metainfo/Happ.metainfo.xml"
	install-license LICENSE "happ/LICENSE.nivora"
}

files() {
	files-find "/opt/happ/**/*"
	files-find-binary
	files-find-desktop
	files-find-systemd
	files-find-license
	files-find \
		"/usr/share/metainfo/Happ.metainfo.xml" \
		"/usr/share/icons/hicolor/512x512/apps/happ.png" \
		"/usr/share/mime/packages/happ-mime.xml"
}
