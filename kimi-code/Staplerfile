name='kimi-code'
version='1.1.0'
release=3
# SHA-256 of the final HTTP ETag for the mutable download URL. The
# autonomous detector compares these even when upstream keeps the version.
source_fingerprint_amd64='055970719a8fba3773beb51de404aaaeb2ce52a9120f620ccd04c4fe988964e3'
summary='Kimi Code Desktop — AI coding agent by Moonshot AI'
summary_ru='Десктопный AI-агент Kimi Code от Moonshot AI'
group='Development/Tools'
desc='Kimi Code Desktop is the official desktop client of the Kimi Code agent by Moonshot AI: open a local project, talk to the agent, and ship changes in one window. Built on the Kimi K3 model family with a context window of up to 1M tokens.'
desc_ru='Kimi Code Desktop — официальный десктопный клиент агента Kimi Code от Moonshot AI: откройте локальный проект, общайтесь с агентом и доводите изменения до конца в одном окне. Работает на моделях семейства Kimi K3 с контекстным окном до 1 млн токенов.'
homepage='https://www.kimi.com/code'
maintainer='Moonshot AI <support@moonshot.cn>'

architectures=('amd64')
compatible_with=('altlinux')

license=('LicenseRef-proprietary')

appstream_app_id='com.kimi.code.desktop'
nonfree=1
nonfree_msg='Kimi Code Desktop является проприетарным приложением Moonshot AI. Использование приложения, учётной записи Kimi, подписки и сетевых функций регулируется условиями Moonshot AI.'
nonfree_url='https://www.kimi.com/terms'

provides=()
replaces=('kimi-code')
conflicts=()

auto_reqprov_method="dirty"
auto_req=1
auto_prov=0
disable_network=1

# auto_req covers everything readelf -d confirms as real DT_NEEDED of the
# installed kimi-code binary (gtk3, nss, at-spi2, gbm, xcb, glibc, ...).
# The rest stays explicit because it never shows up in that scan: xdg-utils
# is a subprocess tool, and libnotify/libsecret/libXtst/libXScrnSaver/libuuid
# are dlopen'd by Chromium's Linux integration layer - the app starts without
# them, but loses notifications, keyring, global input, idle detection and
# D-Bus integration, so they stay hard deps for the real functionality.
# mesa-dri-drivers backs the hardware GL path; the bundled vk_swiftshader is
# only the software Vulkan fallback.
deps=('libnotify' 'libsecret' 'libXtst' 'libXScrnSaver' 'xdg-utils' 'libuuid' 'mesa-dri-drivers')

opt_deps=('libappindicator-gtk3' 'gnome-keyring' 'git' 'ca-certificates')

build_deps=('binutils')

# The download URL carries no version, so the nivora= query keeps the Stapler
# local-cache key tied to the pinned payload; the value is the ETag
# fingerprint above. Do not drop the parameter when updating the recipe.
sources=(
	"https://code.kimi.com/kimi-code/desktop/download/KimiCode-linux-amd64.deb?nivora=${source_fingerprint_amd64}&~archive=false&~name=kimi-code.deb"
	'local:///LICENSE?nivora=kimi-code'
)

checksums=(
	'sha256:58ca6d5780d7567be48d8704c7f4b656128222b9d96153246c5f0221374ed336'
	'sha256:a2f0b091b653467dcc16cb2db6c11a94d3b3b983686dd3eecfa7e7e9f51a4c1b'
)

scripts=(
	['postinstall']='postinstall.sh'
	['preremove']='preremove.sh'
	['postremove']='postremove.sh'
)

package() {
	cd "${srcdir}"

	mkdir -p "${srcdir}/extracted"
	ar x kimi-code.deb
	tar -xf data.tar.* -C "${srcdir}/extracted"

	# Keep the upstream install path: the shipped AppArmor profile grants
	# user namespaces specifically to /opt/Kimi Code/kimi-code.
	install -dm755 "${pkgdir}/opt"
	cp -a "${srcdir}/extracted/opt/Kimi Code" "${pkgdir}/opt/"
	chmod 4755 "${pkgdir}/opt/Kimi Code/chrome-sandbox"
	chmod 755 \
		"${pkgdir}/opt/Kimi Code/kimi-code" \
		"${pkgdir}/opt/Kimi Code/chrome_crashpad_handler"

	# Fail the build if upstream moves the binary the AppArmor profile names.
	grep -Fq '"/opt/Kimi Code/kimi-code"' \
		"${srcdir}/extracted/opt/Kimi Code/resources/apparmor-profile"
	install -Dm644 \
		"${srcdir}/extracted/opt/Kimi Code/resources/apparmor-profile" \
		"${pkgdir}/etc/apparmor.d/kimi-code"

	install -dm755 "${pkgdir}/usr/bin"
	ln -sfn '/opt/Kimi Code/kimi-code' "${pkgdir}/usr/bin/kimi-code"

	# The AppStream component claims this desktop id; make the build fail
	# here rather than shipping a component nothing can launch.
	# Absolute links resolve against the build host, not pkgdir. Check the
	# staged target directly so a first installation can build successfully.
	test -f "${pkgdir}/opt/Kimi Code/kimi-code"
	# Upstream ships StartupWMClass=Kimi Code, but the packaged app names
	# itself "kimi-code-app" (root package.json of app.asar, no productName),
	# and Electron turns that name into the X11 WM_CLASS - with the upstream
	# value the shell cannot match the running window back to this desktop
	# entry, so the taskbar shows a generic icon and the raw class name.
	sed -i \
		-e '0,/^Name=/{s/^Name=.*/Name=Kimi Code\nName[ru]=Kimi Code/}' \
		-e 's/^StartupWMClass=.*/StartupWMClass=kimi-code-app/' \
		"${srcdir}/extracted/usr/share/applications/kimi-code.desktop"
	install-desktop "${srcdir}/extracted/usr/share/applications/kimi-code.desktop"

	cp -a "${srcdir}/extracted/usr/share/icons" "${pkgdir}/usr/share/"
	# The deb ships a single 512x512 hicolor icon; without a generated theme
	# cache some shells do not resolve it, so keep the pixmaps copy the
	# GNOME/KDE fallbacks always read (same pattern as the chatgpt package).
	install -Dm644 \
		"${srcdir}/extracted/usr/share/icons/hicolor/512x512/apps/kimi-code.png" \
		"${pkgdir}/usr/share/pixmaps/kimi-code.png"

	# Upstream ships its own AppStream document, with component id
	# com.kimi.code.desktop launching kimi-code.desktop. It is installed as-is
	# rather than replaced by a generated one.
	install -Dm644 \
		"${srcdir}/extracted/usr/share/metainfo/com.kimi.code.desktop.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/com.kimi.code.desktop.metainfo.xml"

	install-license LICENSE "kimi-code/LICENSE.nivora"
	install -Dm644 "${srcdir}/extracted/opt/Kimi Code/LICENSE.electron.txt" \
		"${pkgdir}/usr/share/licenses/kimi-code/LICENSE.electron.txt"
	install -Dm644 "${srcdir}/extracted/opt/Kimi Code/LICENSES.chromium.html" \
		"${pkgdir}/usr/share/licenses/kimi-code/LICENSES.chromium.html"
}

files() {
	files-find "/opt/Kimi Code/**/*"
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/com.kimi.code.desktop.metainfo.xml" \
		"/usr/share/icons/hicolor/512x512/apps/kimi-code.png" \
		"/usr/share/pixmaps/kimi-code.png" \
		"/etc/apparmor.d/kimi-code"
}
