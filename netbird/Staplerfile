name='netbird'
version='0.84.0'
release=1

summary='Peer-to-peer private networking with WireGuard'
summary_ru='Частная сеть между устройствами через WireGuard'
desc='NetBird connects peers over WireGuard and provides a command-line client and a system service.'
desc_ru='Клиент NetBird объединяет устройства в сеть WireGuard. В пакет входят команда netbird и системная служба.'
group='Networking/Other'
homepage='https://netbird.io'
maintainer='NetBird <dev@netbird.io>'
license=('BSD-3-Clause')

architectures=('amd64' 'arm64')
compatible_with=('altlinux_p11')
disable_network=1

provides=()
replaces=('netbird')
conflicts=()
backup=('/etc/sysconfig/netbird')

auto_reqprov_method='dirty'
auto_req=0
auto_prov=0
deps=('ca-certificates' 'iproute2' 'iptables' 'systemd')

sources=(
	"https://github.com/netbirdio/netbird/releases/download/v${version}/netbird_${version}_linux_amd64.tar.gz?~archive=false&~name=netbird.tar.gz"
	'local:///netbird.service'
	'local:///netbird.sysconfig'
)
checksums=(
	'sha256:2d570cd4edba9231bb2d71133d6d8128c19073d189ec319631ca43429b9e614e'
	'sha256:d1929d1c902ffd7b5774eb03b5e11243d910f28acacc601e7d1a045b18419ace'
	'sha256:9a7da6daa92bddaf0fd2286cbbe2688291cb0bdc84fe3b9935fb2df84bdedea3'
)
sources_arm64=(
	"https://github.com/netbirdio/netbird/releases/download/v${version}/netbird_${version}_linux_arm64.tar.gz?~archive=false&~name=netbird.tar.gz"
	'local:///netbird.service'
	'local:///netbird.sysconfig'
)
checksums_arm64=(
	'sha256:8099c6095ff6dfe4468ae23095c65850d5c4ae3c823492e73574984d3553816e'
	'sha256:d1929d1c902ffd7b5774eb03b5e11243d910f28acacc601e7d1a045b18419ace'
	'sha256:9a7da6daa92bddaf0fd2286cbbe2688291cb0bdc84fe3b9935fb2df84bdedea3'
)

scripts=(
	['postinstall']='postinstall.sh'
	['preremove']='preremove.sh'
	['postremove']='postremove.sh'
)

package() {
	tar --no-same-owner --no-same-permissions -xzf netbird.tar.gz netbird LICENSE
	install-binary netbird
	install-systemd netbird.service
	install -Dm600 netbird.sysconfig "${pkgdir}/etc/sysconfig/netbird"
	install-license LICENSE 'netbird/LICENSE'
}

files() {
	files-find-binary
	files-find-systemd
	files-find-license
	printf '%s\n' '/etc/sysconfig/netbird'
}
