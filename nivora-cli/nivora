}

need_stapler() {
    command -v stplr >/dev/null 2>&1 || fail "$(message stapler_missing)"
}

privilege_command() {
    [[ "$EUID" -eq 0 ]] && return
    local command_name="${NIVORA_SUDO:-sudo}"
    command -v "$command_name" >/dev/null 2>&1 ||
        fail "$(message privilege_missing): ${command_name}"
    printf '%s\n' "$command_name"
}

is_package_name() {
    local value="$1"
    [[ -n "$value" &&
       "$value" != -* &&
       "$value" != */* &&
       "$value" != ./* &&
       "$value" != ../* &&
       "$value" != /* &&
       "$value" != *.rpm &&
       "$value" != *.deb &&
       "$value" != *.pkg.tar.* ]]
}

normalize_packages() {
    local argument
    for argument in "$@"; do
        case "$argument" in
            codex)
                printf '%sNivora:%s %s; %s chatgpt.\n' \
                    "$yellow" "$reset" "$(message legacy_package)" \
                    "$(message legacy_using)" >&2
                argument='chatgpt'
                ;;
            nivora/codex)
                printf '%sNivora:%s %s; %s nivora/chatgpt.\n' \
                    "$yellow" "$reset" "$(message legacy_package)" \
                    "$(message legacy_using)" >&2
                argument='nivora/chatgpt'
                ;;
            */codex)
                if [[ "${argument%/*}" == "$repository" ]]; then
                    printf '%sNivora:%s %s; %s %s/chatgpt.\n' \
                        "$yellow" "$reset" "$(message legacy_package)" \
                        "$(message legacy_using)" "${argument%/*}" >&2
                    argument="${argument%/*}/chatgpt"
                fi
                ;;
        esac
        if [[ "$repository" != 'none' ]] && is_package_name "$argument"; then
            printf '%s/%s\n' "$repository" "$argument"
        else
            printf '%s\n' "$argument"
        fi
    done
}

print_command() {
    local label
    if [[ "$dry_run" -eq 1 ]]; then
        label="$(message preview)"
    else
        label="$(message running)"
    fi
    printf '%s%s%s%s %s›%s' "$bold" "$blue" "$label" "$reset" "$cyan" "$reset" >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
}

run_stapler() {
    local access="$1"
    shift
    need_stapler

    local -a command=()
    local privilege
    if [[ "$access" == 'privileged' ]]; then
        privilege="$(privilege_command)"
        [[ -n "$privilege" ]] && command+=("$privilege")
    fi
    command+=(stplr "$@")

    [[ "${NIVORA_QUIET:-0}" == '1' ]] || print_command "${command[@]}"
    [[ "$dry_run" -eq 1 ]] && return
    exec "${command[@]}"
}

require_arguments() {
    local command_name="$1"
    local count="$2"
    [[ "$count" -gt 0 ]] || fail "$(message missing_argument): ${command_name}"
}

version_at_least() {
    local current="${1#v}"
    local minimum="${2#v}"
    local current_major current_minor current_patch
    local minimum_major minimum_minor minimum_patch
    current="${current%%[-+]*}"
    minimum="${minimum%%[-+]*}"
    IFS='.' read -r current_major current_minor current_patch <<<"$current"
    IFS='.' read -r minimum_major minimum_minor minimum_patch <<<"$minimum"
    [[ "$current_major" =~ ^[0-9]+$ && "$current_minor" =~ ^[0-9]+$ &&
       "$current_patch" =~ ^[0-9]+$ && "$minimum_major" =~ ^[0-9]+$ &&
       "$minimum_minor" =~ ^[0-9]+$ && "$minimum_patch" =~ ^[0-9]+$ ]] || return 1
    (( 10#$current_major > 10#$minimum_major )) && return 0
    (( 10#$current_major < 10#$minimum_major )) && return 1
    (( 10#$current_minor > 10#$minimum_minor )) && return 0
    (( 10#$current_minor < 10#$minimum_minor )) && return 1
    (( 10#$current_patch >= 10#$minimum_patch ))
}

detect_package_manager() {
    local candidate
    for candidate in pacman apt-get dnf yum apk zypper epm; do
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

doctor_row() {
    local color="$1"
    local label="$2"
    local value="$3"
    printf '  %s●%s %-18s %s\n' "$color" "$reset" "$label" "$value"
}

doctor() {
    local failures=0
    local privilege="${NIVORA_SUDO:-sudo}"
    local stapler_available=0
    local manager=''
    local version_output=''
    local stapler_version=''
    local repo_output=''
    local compact_repo_output=''
    printf '%s%s%s\n\n' "$bold" "$(message diagnostics)" "$reset"

    if command -v stplr >/dev/null 2>&1; then
        stapler_available=1
        doctor_row "$green" 'Stapler' "$(message available)"
    else
        doctor_row "$red" 'Stapler' "$(message missing)"
        failures=1
    fi

    if [[ "$stapler_available" -eq 1 ]]; then
        if version_output="$(stplr version 2>/dev/null)"; then
            stapler_version="$(grep -Eo 'v?[0-9]+\.[0-9]+\.[0-9]+' <<<"$version_output" | head -n 1 || true)"
            if [[ -z "$stapler_version" ]]; then
                doctor_row "$yellow" "$(message version)" "$(message version_unknown)"
                failures=1
            elif version_at_least "$stapler_version" "$MIN_STAPLER_VERSION"; then
                doctor_row "$green" "$(message version)" "$stapler_version (>= v${MIN_STAPLER_VERSION})"
            else
                doctor_row "$red" "$(message version)" \
                    "$stapler_version; $(message version_too_old)"
                failures=1
            fi
        else
            doctor_row "$red" "$(message version)" "$(message version_unknown)"
            failures=1
        fi
    else
        doctor_row "$red" "$(message version)" "$(message missing)"
    fi

    if manager="$(detect_package_manager)"; then
        doctor_row "$green" "$(message manager)" "$manager"
    else
        doctor_row "$red" "$(message manager)" "$(message manager_missing)"
        failures=1
    fi

    if [[ "$EUID" -eq 0 ]] || command -v "$privilege" >/dev/null 2>&1; then
        doctor_row "$green" "$(message privileges)" \
            "$([[ "$EUID" -eq 0 ]] && printf 'root' || printf '%s' "$privilege")"
    else
        doctor_row "$red" "$(message privileges)" "$(message missing)"
        failures=1
    fi

    doctor_row "$green" "$(message language)" "$language"
    doctor_row "$green" "$(message repository)" "$repository"

    if [[ "$repository" == 'none' ]]; then
        doctor_row "$blue" "$(message index)" "$(message index_skipped)"
    elif [[ "$stapler_available" -eq 1 ]]; then
        if repo_output="$(stplr repo list --json 2>/dev/null)"; then
            compact_repo_output="${repo_output//[[:space:]]/}"
            if [[ -z "$compact_repo_output" ]]; then
                doctor_row "$yellow" "$(message repositories)" "$(message repo_unknown)"
            elif grep -Fq "\"name\":\"${repository}\"" <<<"$compact_repo_output"; then
                doctor_row "$green" "$(message repositories)" \
                    "${repository}: $(message repo_configured)"
            else
                doctor_row "$red" "$(message repositories)" \
                    "${repository}: $(message repo_missing)"
                failures=1
            fi
        else
            doctor_row "$red" "$(message repositories)" "$(message repo_unknown)"
            failures=1
        fi

        if stplr info "${repository}/nivora-cli" >/dev/null 2>&1; then
            doctor_row "$green" "$(message index)" "$(message index_ready)"
        else
            doctor_row "$red" "$(message index)" "$(message index_missing)"
            failures=1
        fi
    else
        doctor_row "$red" "$(message repositories)" "$(message repo_unknown)"
        doctor_row "$red" "$(message index)" "$(message missing)"
    fi

    doctor_row "$blue" "$(message refresh_policy)" "$(message explicit_refresh)"
    printf '\n'

    if [[ "$failures" -eq 0 ]]; then
        printf '%s✓ %s%s\n' "$green" "$(message ready)" "$reset"
    else
        printf '%s✗ %s%s\n' "$red" "$(message problems)" "$reset"
    fi
    return "$failures"
}

completion() {
    local shell="${1:-}"
    case "$shell" in
        bash)
            sed "s/@PACKAGES@/${PACKAGE_COMPLETIONS}/" <<'EOF'
_nivora() {
    local commands='install remove upgrade info list build refresh fix helper version search repo config migrate support raw doctor completion help'
    local packages='@PACKAGES@'
    if (( COMP_CWORD == 1 )); then
        COMPREPLY=($(compgen -W "$commands" -- "${COMP_WORDS[COMP_CWORD]}"))
    elif [[ "${COMP_WORDS[1]}" == 'install' || "${COMP_WORDS[1]}" == 'remove' ||
            "${COMP_WORDS[1]}" == 'info' ]]; then
        COMPREPLY=($(compgen -W "$packages" -- "${COMP_WORDS[COMP_CWORD]}"))
    fi
}
complete -F _nivora nv
EOF
            ;;
        fish)
            sed "s/@PACKAGES@/${PACKAGE_COMPLETIONS}/" <<'EOF'
complete -c nv -f -n '__fish_use_subcommand' -a 'install remove upgrade info list build refresh fix helper version search repo config migrate support raw doctor completion help'
complete -c nv -f -n '__fish_seen_subcommand_from install remove info' -a '@PACKAGES@'
EOF
            ;;
        zsh)
            sed "s/@PACKAGES@/${PACKAGE_COMPLETIONS}/" <<'EOF'
#compdef nv
_arguments '1:command:(install remove upgrade info list build refresh fix helper version search repo config migrate support raw doctor completion help)' '*::argument:->arguments'
if (( CURRENT > 2 )) && [[ "$words[2]" == (install|remove|info) ]]; then
    _values 'package' @PACKAGES@
fi
EOF
            ;;
        *) fail "$(message missing_argument): completion <bash|fish|zsh>" ;;
    esac
}

dispatch() {
    local command_name="${1:-help}"
    [[ "$#" -gt 0 ]] && shift

    case "$command_name" in
        install | in | i)
            require_arguments "$command_name" "$#"
            local -a packages=()
            mapfile -t packages < <(normalize_packages "$@")
            run_stapler privileged install "${packages[@]}"
            ;;
        remove | rm | erase | e)
            require_arguments "$command_name" "$#"
            local -a packages=()
            mapfile -t packages < <(normalize_packages "$@")
            run_stapler privileged remove "${packages[@]}"
            ;;
        upgrade | update | up | u) run_stapler privileged up "$@" ;;
        search | s)
            require_arguments "$command_name" "$#"
            run_stapler user search "$@"
            ;;
        info | query-info | qi)
            require_arguments "$command_name" "$#"
            local -a packages=()
            mapfile -t packages < <(normalize_packages "$@")
            run_stapler user info "${packages[@]}"
            ;;
        list | ls | packages | query-all | qa) run_stapler user list "$@" ;;
        build) run_stapler user build "$@" ;;
        refresh | ref | r) run_stapler privileged refresh "$@" ;;
        repo-list | rl) run_stapler user repo list "$@" ;;
        repo)
            if [[ "$#" -eq 0 ]]; then
                run_stapler user repo list
            elif [[ "${1:-}" == 'list' || "${1:-}" == 'ls' ]]; then
                run_stapler user repo "$@"
            else
                run_stapler privileged repo "$@"
            fi
            ;;
        fix | f) run_stapler privileged fix "$@" ;;
        helper) run_stapler user helper "$@" ;;
        migrate) run_stapler privileged migrate "$@" ;;
        doctor | d) doctor ;;
        config | c)
            if [[ "$#" -eq 0 ]]; then
                run_stapler user config show
            elif [[ "${1:-}" == 'set' ]]; then
                run_stapler privileged config "$@"
            else
                run_stapler user config "$@"
            fi
            ;;
        completion) completion "$@" ;;
        support) run_stapler user support "$@" ;;
        raw | stplr) run_stapler user "$@" ;;
        version | v | --version)
            printf 'Nivora CLI %s\n' "$NIVORA_VERSION"
            command -v stplr >/dev/null 2>&1 && stplr version
            ;;
        help | h | -h | --help) show_help ;;
        *) fail "$(message unknown_command): ${command_name}" ;;
    esac
}

main() {
    detect_language
    setup_style
    parse_options "$@"
    set -- "${arguments[@]}"

    case "$(basename "$0")" in
        nv)
            if [[ "$#" -eq 0 ]]; then interactive_menu; else dispatch "$@"; fi
            ;;
        nvi) dispatch install "$@" ;;
        nve) dispatch remove "$@" ;;
        nvu) dispatch upgrade "$@" ;;
        nvs) dispatch search "$@" ;;
        nvqi) dispatch info "$@" ;;
        nvqa) dispatch list "$@" ;;
        nvr) dispatch refresh "$@" ;;
        nvrl) dispatch repo-list "$@" ;;
        nvf) dispatch fix "$@" ;;
        nvd) doctor ;;
        nvc) dispatch config "$@" ;;
        nivora) dispatch "$@" ;;
        *) fail "$(message unknown_command): $(basename "$0")" ;;
    esac
}

main "$@"
