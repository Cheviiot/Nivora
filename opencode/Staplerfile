package() {
	unpack_dir="$(mktemp -d "${srcdir}/opencode.XXXXXX")" || return 1
	cd "${unpack_dir}" || return 1
	ar x "${srcdir}/opencode.deb" || return 1
	tar -xf data.tar.* || return 1

	payload="${pkgdir}/opt/OpenCode"
	install -dm755 "${pkgdir}/opt" "${pkgdir}/usr/bin"
	mv -T opt/OpenCode "${payload}"
	chmod 4755 "${payload}/chrome-sandbox"
	test -x "${payload}/ai.opencode"
	test -x "${payload}/resources/opencode-cli"
	ln -sfn /opt/OpenCode/ai.opencode "${pkgdir}/usr/bin/opencode-desktop"

	# Only glibc addons can load on p11. The musl variants add a spurious libc.so dependency.
	find "${payload}" -type f \
		\( -name '*.musl.node' -o -path '*-musl/*.node' \) -delete

	install -Dm644 usr/share/applications/ai.opencode.desktop.desktop \
		"${pkgdir}/usr/share/applications/ai.opencode.desktop.desktop"
	install -dm755 "${pkgdir}/usr/share/icons"
	mv usr/share/icons/hicolor "${pkgdir}/usr/share/icons/"
	install -Dm644 "${srcdir}/ai.opencode.desktop.png" \
		"${pkgdir}/usr/share/icons/hicolor/128x128/apps/ai.opencode.desktop.png"
	install -Dm644 "${srcdir}/ai.opencode.desktop.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/ai.opencode.desktop.metainfo.xml"

	install-license "${srcdir}/LICENSE" 'opencode/LICENSE.nivora'
	install-license "${payload}/LICENSE.electron.txt" 'opencode/LICENSE.electron.txt'
	install-license "${payload}/LICENSES.chromium.html" 'opencode/LICENSES.chromium.html'
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/opt/OpenCode/**/*" \
		"/usr/share/icons/hicolor/*/apps/ai.opencode.png" \
		"/usr/share/icons/hicolor/*/apps/ai.opencode.desktop.png" \
		"/usr/share/metainfo/ai.opencode.desktop.metainfo.xml"
}
