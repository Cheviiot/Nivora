name='opencode'
version='1.19.0'
release=1
summary='Open source AI coding agent desktop app'
summary_ru='Десктопное приложение AI-агента OpenCode для работы с кодом'
group='Development/Tools'
desc='OpenCode Desktop is an open source AI coding agent for working on software projects with multiple model providers.'
desc_ru='OpenCode Desktop — открытый AI-агент для работы над программными проектами с поддержкой разных провайдеров моделей.'
homepage='https://opencode.ai'
maintainer='OpenCode <hello@opencode.ai>'

architectures=('amd64' 'arm64')
compatible_with=('altlinux')
disable_network=1

license=('MIT')
appstream_app_id='ai.opencode.desktop'
appstream_name='OpenCode'
appstream_developer='Anomaly Innovations Inc.'

provides=()
replaces=('opencode')
conflicts=()

# RPM scans the ELF payload for its linked libraries. Bundled musl addons are
# removed below because they cannot load on ALT's glibc runtime.
auto_reqprov_method="dirty"
auto_req=1
auto_prov=0

# Electron loads these through dlopen or invokes them as subprocesses.
deps=('libnotify' 'libXScrnSaver' 'libXtst' 'xdg-utils' 'libuuid' 'libsecret')
opt_deps=('libappindicator-gtk3' 'gnome-keyring' 'git')
build_deps=('binutils')

sources=(
	"https://github.com/anomalyco/opencode/releases/download/v${version}/opencode-desktop-linux-amd64.deb?~archive=false&~name=opencode.deb"
	'local:///LICENSE?nivora=opencode'
	'local:///ai.opencode.desktop.png'
	'local:///ai.opencode.desktop.metainfo.xml?nivora=opencode'
)

sources_arm64=(
	"https://github.com/anomalyco/opencode/releases/download/v${version}/opencode-desktop-linux-arm64.deb?~archive=false&~name=opencode.deb"
	'local:///LICENSE?nivora=opencode'
	'local:///ai.opencode.desktop.png'
	'local:///ai.opencode.desktop.metainfo.xml?nivora=opencode'
)

