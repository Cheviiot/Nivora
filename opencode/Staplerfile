scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	cd "${srcdir}"
	mkdir -p extracted
	ar x opencode.deb
	tar -xf data.tar.* -C extracted

	install -dm755 "${pkgdir}/opt"
	cp -a extracted/opt/OpenCode "${pkgdir}/opt/"
	chmod 4755 "${pkgdir}/opt/OpenCode/chrome-sandbox"

	# The glibc variants remain; musl variants produce an unsatisfiable
	# libc.so Requires on ALT despite never being loaded there.
	find "${pkgdir}/opt/OpenCode" -type f \
		\( -name '*.musl.node' -o -path '*-musl/*.node' \) -delete

	install -Dm644 \
		extracted/usr/share/applications/ai.opencode.desktop.desktop \
		"${pkgdir}/usr/share/applications/ai.opencode.desktop.desktop"
	install -dm755 "${pkgdir}/usr/share/icons"
	cp -a extracted/usr/share/icons/hicolor "${pkgdir}/usr/share/icons/"
	install -Dm644 ai.opencode.desktop.png \
		"${pkgdir}/usr/share/icons/hicolor/128x128/apps/ai.opencode.desktop.png"
	install -Dm644 ai.opencode.desktop.metainfo.xml \
		"${pkgdir}/usr/share/metainfo/ai.opencode.desktop.metainfo.xml"

	install -dm755 "${pkgdir}/usr/bin"
	ln -sfn /opt/OpenCode/ai.opencode.desktop \
		"${pkgdir}/usr/bin/opencode-desktop"
	install-license LICENSE "opencode/LICENSE.nivora"
	install -Dm644 "${pkgdir}/opt/OpenCode/LICENSE.electron.txt" \
		"${pkgdir}/usr/share/licenses/opencode/LICENSE.electron.txt"
	install -Dm644 "${pkgdir}/opt/OpenCode/LICENSES.chromium.html" \
		"${pkgdir}/usr/share/licenses/opencode/LICENSES.chromium.html"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/opt/OpenCode/**/*" \
		"/usr/share/icons/hicolor/*/apps/ai.opencode.desktop.png" \
		"/usr/share/metainfo/ai.opencode.desktop.metainfo.xml"
}
