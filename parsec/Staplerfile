name='parsec'
version='150-104a'
release=17
# SHA-256 of the final HTTP ETag for the versionless upstream DEB.
source_fingerprint='1bdf98c2922f6cb3fbab46afd9a5609f6fae2b2136d3b573c6589b83b364ce37'

summary='Low-latency client for remote desktops and games'
summary_ru='Клиент удалённого рабочего стола и игр с низкой задержкой'
desc='Parsec is a client for connecting to remote computers and streaming their desktop or games with low latency.'
desc_ru='Parsec — клиент для подключения к удалённым компьютерам и трансляции их рабочего стола или игр с низкой задержкой.'
group='Networking/Remote access'
homepage='https://parsec.app/downloads'
maintainer='Cheviiot <Cheviiot@users.noreply.github.com>'

license=('LicenseRef-proprietary')
nonfree=1
nonfree_msg='Parsec — проприетарное приложение. Условия Unity для Parsec приведены по ссылке ниже.'
nonfree_url='https://parsec.app/terms'

appstream_app_id='parsecd'
appstream_name='Parsec'
appstream_developer='Parsec Cloud, Inc.'

architectures=('amd64')
compatible_with=('altlinux_p11')
disable_network=1

provides=()
replaces=('parsec')
conflicts=()

auto_reqprov_method='dirty'
auto_req=0
auto_prov=0

# ALT p11 ships the FFmpeg ABI used by Parsec in libavcodec61.
deps=(
	'glibc' 'libgcc1' 'libstdc++6' 'libudev0' 'libssl3'
	'libX11' 'libXcursor' 'libXi' 'libSM' 'libGL' 'libalsa'
	'libjpeg8' 'libpng16' 'libcurl' 'libXrandr' 'libvulkan1' 'libavcodec61'
)
build_deps=('binutils')

sources=(
	'https://builds.parsec.app/package/parsec-linux.deb?~archive=false&~name=parsec.deb'
	'local:///parsecd-wrapper'
	'local:///LICENSE?nivora=parsec'
	'local:///parsecd.metainfo.xml?nivora=parsec'
)
checksums=(
	'sha256:c8a4407713d72dcb1c59f082977e81e1b9e8ffd679d0666882cde4c8a0821dd2'
	'sha256:c3c6f25bac90d87414d38f248f5b94f7cefd468b48d100f669b6ddc52c094a1d'
	'sha256:47e645b5635b79fc4744884668b2c43cd32ea0b236fb528640c3ac9076504677'
	'sha256:481f43da8d43361557ff93d5020cf78c8977a933045851bca7d45d0d34402f34'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	unpack_dir="$(mktemp -d "${srcdir}/parsec.XXXXXX")" || return 1
	cd "${unpack_dir}" || return 1
	ar x "${srcdir}/parsec.deb" || return 1
	tar -xf data.tar.* || return 1

	install -Dm755 usr/bin/parsecd "${pkgdir}/usr/lib/parsec/parsecd"
	install -Dm755 "${srcdir}/parsecd-wrapper" "${pkgdir}/usr/bin/parsecd"
	install -dm755 "${pkgdir}/usr/share"
	mv usr/share/parsec "${pkgdir}/usr/share/"

	desktop_file="${pkgdir}/usr/share/applications/parsecd.desktop"
	install -Dm644 usr/share/applications/parsecd.desktop "${desktop_file}"
	sed -i 's/^Categories=.*/Categories=Network;RemoteAccess;/' "${desktop_file}"
	install -Dm644 usr/share/icons/hicolor/256x256/apps/parsecd.png \
		"${pkgdir}/usr/share/icons/hicolor/256x256/apps/parsecd.png"
	install -Dm644 "${srcdir}/parsecd.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/parsecd.metainfo.xml"

	install-license "${srcdir}/LICENSE" 'parsec/LICENSE.nivora'
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/parsecd.metainfo.xml" \
		"/usr/lib/parsec/parsecd" \
		"/usr/share/icons/hicolor/256x256/apps/parsecd.png" \
		"/usr/share/parsec/**/*"
}
