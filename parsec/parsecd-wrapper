#!/bin/bash
set -euo pipefail

real_binary="${PARSEC_BINARY:-/usr/lib/parsec/parsecd}"

immersive_enabled() {
    case "${PARSEC_NIVORA_IMMERSIVE:-1}" in
    0 | false | no | off) return 1 ;;
    *) return 0 ;;
    esac
}

immersive_enabled || exec "${real_binary}" "$@"
for arg in "$@"; do
    # An explicit launch option must not also change the saved default.
    if [[ "${arg}" == *client_immersive=* ]]; then
        exec "${real_binary}" "$@"
    fi
done

parsec_home="${PARSEC_CONFIG_HOME:-${HOME}/.parsec}"
config_txt="${parsec_home}/config.txt"
config_json="${parsec_home}/config.json"
json_notice='See https://parsec.app/config for documentation and example. JSON must be valid before saving or file be will be erased.'

# Keep a legacy profile in its original format. Read the last assignment,
# including an unfamiliar value, before deciding whether a default is needed.
set_config_txt_immersive() {
    local line value='' found=0
    if [[ -e "$config_txt" || -L "$config_txt" ]]; then
        [[ -f "$config_txt" && -r "$config_txt" ]] || return 3
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ ^[[:space:]]*client_immersive[[:space:]]*=(.*)$ ]]; then
                found=1
                value="${BASH_REMATCH[1]}"
            fi
        done <"$config_txt" || return 3
        if [[ "$found" -eq 1 ]]; then
            if [[ "$value" =~ ^[[:space:]]*([+-]?[0-9]+)[[:space:]]*(#.*)?$ ]]; then
                printf '%s\n' "${BASH_REMATCH[1]}"
                return 0
            fi
            return 3
        fi
        # Read a chosen value through a symlink, but never rewrite its target.
        [[ ! -L "$config_txt" ]] || return 3
    fi
    umask 077
    mkdir -p "${parsec_home}" || return 3
    printf '\nclient_immersive=2\n' >>"${config_txt}" || return 3
    printf '2\n'
}

# 0 returns a value, 3 leaves all settings to Parsec, 4 selects the TXT path.
# An unreadable JSON must never be treated as permission to fall back to TXT.
set_config_json_immersive() {
    if ! command -v python3 >/dev/null 2>&1; then
        # We cannot establish that an existing JSON profile has no choice.
        # In particular, do not create TXT=2 and override an unread JSON=0.
        [[ ! -e "$config_json" && ! -L "$config_json" ]] || return 3
        return 4
    fi

    python3 - "${config_json}" "${config_txt}" "${json_notice}" <<'PY'
import json
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

MISSING = object()

path = Path(sys.argv[1])
legacy = Path(sys.argv[2])
notice = sys.argv[3]
temporary = None

try:
    original = None
    mode = 0o600
    if path.exists() or path.is_symlink():
        original = path.read_bytes()
        mode = stat.S_IMODE(path.stat().st_mode)
        data = json.loads(original)
    else:
        data = [notice, {}]

    if isinstance(data, dict):
        settings = data
    elif (isinstance(data, list) and len(data) == 2
          and isinstance(data[0], str) and isinstance(data[1], dict)):
        settings = data[1]
    else:
        # An unfamiliar valid JSON shape is not an empty configuration.
        raise SystemExit(3)

    current = settings.get("client_immersive", MISSING)
    if current is not MISSING:
        value = current.get("value", MISSING) if isinstance(current, dict) else current
        if type(value) is int:
            print(value)
        elif isinstance(value, str) and re.fullmatch(r"[+-]?[0-9]+", value.strip()):
            print(int(value.strip()))
        else:
            # Unknown values belong to the user, including incomplete objects.
            raise SystemExit(3)
        raise SystemExit(0)

    if legacy.exists() or legacy.is_symlink():
        # The legacy profile can still contain the user's setting. Use it
        # directly; migrating unrelated settings is Parsec's responsibility.
        raise SystemExit(4)
    if path.is_symlink():
        raise SystemExit(3)

    settings["client_immersive"] = {"value": 2}
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    # A predictable config.json.tmp can belong to another launch or Parsec.
    # Use a private temporary file and retain the original access mode.
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent,
        prefix=".config.json.", suffix=".tmp", delete=False,
    ) as stream:
        temporary = Path(stream.name)
        os.fchmod(stream.fileno(), mode)
        json.dump(data, stream, ensure_ascii=False, indent=2, sort_keys=True)
        stream.write("\n")

    if original is None:
        # Linking creates the new file exclusively; a concurrent launch must
        # not lose the profile it has just written in the meantime.
        os.link(temporary, path)
    else:
        if path.is_symlink() or path.read_bytes() != original:
            raise SystemExit(3)
        temporary.replace(path)
    print(2)
except (OSError, ValueError, UnicodeError):
    # A read/write error must not prevent launch or authorise a second format.
    raise SystemExit(3)
finally:
    if temporary is not None:
        temporary.unlink(missing_ok=True)
PY
}

immersive_status=0
immersive_value="$(set_config_json_immersive)" || immersive_status=$?
if [[ "$immersive_status" -eq 4 ]]; then
    immersive_status=0
    immersive_value="$(set_config_txt_immersive)" || immersive_status=$?
fi
[[ "$immersive_status" -eq 0 ]] || exec "${real_binary}" "$@"

if (($# == 0)); then
    exec "${real_binary}" "client_immersive=${immersive_value}"
fi

if [[ "$1" == *=* ]]; then
    first_arg="client_immersive=${immersive_value}:${1}"
    shift
    exec "${real_binary}" "${first_arg}" "$@"
fi

exec "${real_binary}" "$@"
