name='pineconemc'
version='11.1.0'
release=3
summary='Discover, manage, and play Minecraft instances'
summary_ru='Поиск, управление и запуск сборок Minecraft'
group='Games/Other'
desc='PineconeMC is a fork of Prism Launcher, a custom launcher for Minecraft that focuses on predictability, long term stability and simplicity, with Ely.by and offline account support added.'
desc_ru='PineconeMC — форк Prism Launcher, лаунчера Minecraft, ориентированного на предсказуемость, долговременную стабильность и простоту, с добавленной поддержкой Ely.by и offline-аккаунтов.'
homepage='https://pineconemc.com/'
maintainer='Cheviiot <Cheviiot@users.noreply.github.com>'

architectures=('amd64' 'arm64')
compatible_with=('altlinux')
disable_network=1

license=('GPL-3.0-only')

provides=()
replaces=('pineconemc')
conflicts=()

# PineconeMC's own binary (opt/pineconemc/shared/bin/elyprismlauncher — the
# statically-linked file at opt/pineconemc/bin/elyprismlauncher is just a
# "sharun"-style bootstrap loader with no dynamic deps of its own, see
# maintenance.md) is Qt6, not GTK3: readelf -d confirmed it and its bundled
# Qt XCB platform plugin need Qt6/X11/GL/zlib, none of which overlap with
# most of the old explicit list. libgtk+3/libICE/libnss/libSM/libdbus/
# libdrm never show up anywhere in the payload's DT_NEEDED — this recipe's
# deps_* arrays look like they were copied from one of the catalog's GTK3
# Electron packages rather than researched for this Qt6 app. auto_req
# replaces the whole guess with what's actually linked; ca-certificates
# (data) and xdg-utils (subprocess) are the only genuinely non-ELF items
# left to keep explicit.
auto_reqprov_method='dirty'
auto_req=1
auto_prov=0

deps=('ca-certificates' 'xdg-utils')

sources=(
	"https://github.com/ElyPrismLauncher/Launcher/releases/download/${version}/PineconeMC-Linux-Qt6-Portable-${version}.tar.gz?~archive=false&~name=pineconemc.tar.gz"
	'local:///LICENSE?nivora=pineconemc'
)

sources_arm64=(
	"https://github.com/ElyPrismLauncher/Launcher/releases/download/${version}/PineconeMC-Linux-aarch64-Qt6-Portable-${version}.tar.gz?~archive=false&~name=pineconemc.tar.gz"
	'local:///LICENSE?nivora=pineconemc'
)

checksums=(
	'sha256:a6a242042f7fd34226f20a1067f93423db7079aaad809bd9ccf02d41e2094e37'
	'sha256:794a4007ac816a1425a98fdddf0716728fe1e2d899c4b9c1d505c1405e111ec9'
)

checksums_arm64=(
	'sha256:c61a6e830b1f0960e927c38f85ea4fa29230f391799dfe548f5b337bef36fb93'
	'sha256:794a4007ac816a1425a98fdddf0716728fe1e2d899c4b9c1d505c1405e111ec9'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

appstream_app_id='io.github.elyprismlauncher.ElyPrismLauncher'

package() {
	cd "${srcdir}"

	mkdir -p "${pkgdir}/opt/pineconemc"
	tar --no-same-owner --no-same-permissions -xzf pineconemc.tar.gz -C "${pkgdir}/opt/pineconemc"
	rm -f "${pkgdir}/opt/pineconemc/portable.txt"

	chmod 755 "${pkgdir}/opt/pineconemc/bin/elyprismlauncher"
	# Upstream enables its updater solely when this helper exists. A failing
	# replacement still triggers background checks and user-visible errors, so
	# packaged installs remove the helper altogether and upgrades stay with Stapler.
	rm -f "${pkgdir}/opt/pineconemc/bin/elyprismlauncher_updater"

	mkdir -p "${pkgdir}/usr/bin"
	ln -sf /opt/pineconemc/bin/elyprismlauncher "${pkgdir}/usr/bin/elyprismlauncher"
	ln -sf /opt/pineconemc/bin/elyprismlauncher "${pkgdir}/usr/bin/pineconemc"

	install -Dm644 "${pkgdir}/opt/pineconemc/share/applications/io.github.elyprismlauncher.ElyPrismLauncher.desktop" \
		"${pkgdir}/usr/share/applications/io.github.elyprismlauncher.ElyPrismLauncher.desktop"
	sed -i 's/^Categories=.*/Categories=Game;/' \
		"${pkgdir}/usr/share/applications/io.github.elyprismlauncher.ElyPrismLauncher.desktop"
	# The fork ships Prism Launcher's AppStream document unchanged, so a
	# graphical installer would name the application "Prism Launcher". The
	# rich parts — screenshots, release history — are kept; only the identity
	# is corrected, and the build fails if upstream stops using this wording.
	metainfo="${pkgdir}/usr/share/metainfo/io.github.elyprismlauncher.ElyPrismLauncher.metainfo.xml"
	install -Dm644 "${pkgdir}/opt/pineconemc/share/metainfo/io.github.elyprismlauncher.ElyPrismLauncher.metainfo.xml" \
		"$metainfo"
	grep -Fq "<name>Prism Launcher</name>" "$metainfo"
	grep -Fq "<name>Prism Launcher Contributors</name>" "$metainfo"
	sed -i \
		-e "s|<name>Prism Launcher</name>|<name>PineconeMC</name>|" \
		-e "s|<name>Prism Launcher Contributors</name>|<name>ElyPrismLauncher</name>|" \
		"$metainfo"
	grep -Fq "<name>PineconeMC</name>" "$metainfo"
	install -Dm644 "${pkgdir}/opt/pineconemc/share/mime/packages/io.github.elyprismlauncher.ElyPrismLauncher.xml" \
		"${pkgdir}/usr/share/mime/packages/io.github.elyprismlauncher.ElyPrismLauncher.xml"
	install -Dm644 "${pkgdir}/opt/pineconemc/share/man/man6/elyprismlauncher.6" \
		"${pkgdir}/usr/share/man/man6/elyprismlauncher.6"

	cp -a "${pkgdir}/opt/pineconemc/share/icons" "${pkgdir}/usr/share/icons"
	install-license "${srcdir}/LICENSE" "pineconemc/LICENSE.nivora"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/opt" \
		"/opt/pineconemc" \
		"/opt/pineconemc/**/*" \
		"/usr/share/icons/hicolor/*/apps/io.github.elyprismlauncher.ElyPrismLauncher.*" \
		"/usr/share/man/man6/elyprismlauncher.6" \
		"/usr/share/metainfo/io.github.elyprismlauncher.ElyPrismLauncher.metainfo.xml" \
		"/usr/share/mime/packages/io.github.elyprismlauncher.ElyPrismLauncher.xml"
}
