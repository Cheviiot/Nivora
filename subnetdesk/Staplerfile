package() {
	cd "${srcdir}"

	mkdir -p "${srcdir}/extracted"
	ar x subnetdesk.deb
	tar -xf data.tar.* -C "${srcdir}/extracted"

	# The Flutter bundle is linked with RUNPATH '$ORIGIN/lib', so the
	# executable and its plugin libraries have to stay together in the
	# directory upstream chose.
	install -dm755 "${pkgdir}/usr/share"
	cp -a "${srcdir}/extracted/usr/share/subnetdesk" "${pkgdir}/usr/share/"
	chmod 755 "${pkgdir}/usr/share/subnetdesk/subnetdesk"

	# Upstream creates this link from its postinst, which leaves it unowned
	# by any package. Shipping it means RPM removes it again, and '$ORIGIN'
	# is resolved from the real path of the binary, so lib/ is still found
	# through the link.
	install -dm755 "${pkgdir}/usr/bin"
	ln -s /usr/share/subnetdesk/subnetdesk "${pkgdir}/usr/bin/subnetdesk"

	# Also copied out of /usr/share by the upstream maintainer scripts. The
	# second entry is the x-scheme-handler/subnetdesk launcher and carries
	# NoDisplay=true, so only the first one shows up in a menu.
	install -Dm644 "${srcdir}/extracted/usr/share/applications/subnetdesk.desktop" \
		"${pkgdir}/usr/share/applications/subnetdesk.desktop"
	install -Dm644 "${srcdir}/extracted/usr/share/applications/subnetdesk-link.desktop" \
		"${pkgdir}/usr/share/applications/subnetdesk-link.desktop"
	# The AppStream launchable points at this exact name, so the build has to
	# fail here if upstream ever renames the desktop entry.
	test -f "${pkgdir}/usr/share/applications/subnetdesk.desktop"

	install -Dm644 \
		"${srcdir}/extracted/usr/share/icons/hicolor/256x256/apps/subnetdesk.png" \
		"${pkgdir}/usr/share/icons/hicolor/256x256/apps/subnetdesk.png"
	install -Dm644 \
		"${srcdir}/extracted/usr/share/icons/hicolor/scalable/apps/subnetdesk.svg" \
		"${pkgdir}/usr/share/icons/hicolor/scalable/apps/subnetdesk.svg"

	# The unit stays byte-identical to the one upstream copies into place;
	# install-systemd only puts it in /usr/lib/systemd/system instead of
	# /etc/systemd/system, where an administrator override belongs.
	install-systemd \
		"${srcdir}/extracted/usr/share/subnetdesk/files/systemd/subnetdesk.service"

	# Template of a headless X session: startwm.sh already takes the
	# /etc/X11/Xsession branch that ALT provides, and xorg.conf describes the
	# dummy display the service starts when nobody is logged in.
	install -Dm755 "${srcdir}/extracted/etc/subnetdesk/startwm.sh" \
		"${pkgdir}/etc/subnetdesk/startwm.sh"
	install -Dm644 "${srcdir}/extracted/etc/subnetdesk/xorg.conf" \
		"${pkgdir}/etc/subnetdesk/xorg.conf"

	# The only file of the payload that is replaced. Upstream's
	# /etc/pam.d/subnetdesk includes Debian's common-auth stack (its .rpm
	# ships no PAM file at all), and ALT has no such service files, so
	# pam_start would fail and logging in with a system account would be
	# impossible. ALT routes everything through system-auth.
	install -Dm644 "${srcdir}/subnetdesk.pam" "${pkgdir}/etc/pam.d/subnetdesk"

	install -Dm644 "${srcdir}/subnetdesk.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/subnetdesk.metainfo.xml"

	install-license LICENSE "subnetdesk/LICENSE.nivora"
	install-license "${srcdir}/LICENCE" "subnetdesk/LICENCE"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-systemd
	files-find-license
	# The two desktop entries are already claimed by files-find-desktop;
	# naming one here again makes Stapler abort with a content collision.
	files-find \
		"/usr/share/metainfo/subnetdesk.metainfo.xml" \
		"/usr/share/subnetdesk/**/*" \
		"/usr/share/icons/hicolor/256x256/apps/subnetdesk.png" \
		"/usr/share/icons/hicolor/scalable/apps/subnetdesk.svg" \
		"/etc/pam.d/subnetdesk" \
		"/etc/subnetdesk/startwm.sh" \
		"/etc/subnetdesk/xorg.conf"
}
