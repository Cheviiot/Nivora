name='tailscale'
version='1.104.7'
release=5

summary='Private networking with WireGuard encryption'
summary_ru='Частная сеть между устройствами с шифрованием WireGuard'
desc='Tailscale connects devices in a private network using WireGuard encryption.'
desc_ru='Tailscale объединяет устройства в частную сеть с шифрованием WireGuard.'
group='Networking/Other'
homepage='https://tailscale.com'
maintainer='Tailscale Inc <info@tailscale.com>'

license=('BSD-3-Clause')

architectures=('amd64' 'arm64')
compatible_with=('altlinux_p11')
disable_network=1

provides=()
replaces=('tailscale')
conflicts=()
backup=('/etc/default/tailscaled')

auto_reqprov_method='dirty'
auto_req=0
auto_prov=0

deps=('iptables' 'iproute2' 'ca-certificates')

sources=(
	"https://pkgs.tailscale.com/stable/tailscale_${version}_amd64.tgz?~archive=false&~name=tailscale.tgz"
	'local:///tailscale-purge-data'
	'local:///LICENSE?nivora=tailscale'
)

checksums=(
	'sha256:e56693ff74a64f2591b7e819c280635a100aae1ddfb0ef058fcd052b7cd8d16c'
	'sha256:fc0e166481e2f97c21dca773ad4bfe673842268935ce1628c14b96af98e70555'
	'sha256:3c7a7d6d7f09890d5e682901acaeb12bda9542fc6450a709c9dc296a91e726a5'
)

sources_arm64=(
	"https://pkgs.tailscale.com/stable/tailscale_${version}_arm64.tgz?~archive=false&~name=tailscale.tgz"
	'local:///tailscale-purge-data'
	'local:///LICENSE?nivora=tailscale'
)

checksums_arm64=(
	'sha256:d6bed2720310b328b861f943d7b4016c5358a9bad60575eb51e8143b79068484'
	'sha256:fc0e166481e2f97c21dca773ad4bfe673842268935ce1628c14b96af98e70555'
	'sha256:3c7a7d6d7f09890d5e682901acaeb12bda9542fc6450a709c9dc296a91e726a5'
)

scripts=(
	['postinstall']='postinstall.sh'
	['preremove']='preremove.sh'
	['postremove']='postremove.sh'
)

package() {
	payload="tailscale_${version}_${ARCH}"
	tar --no-same-owner --no-same-permissions -xzf tailscale.tgz "${payload}"

	install-binary "${payload}/tailscale"
	install-binary tailscale-purge-data
	install -Dm755 "${payload}/tailscaled" "${pkgdir}/usr/sbin/tailscaled"

	install-systemd "${payload}/systemd/tailscaled.service"
	install-systemd "${payload}/systemd/tailscale-wait-online.service"
	install-systemd "${payload}/systemd/tailscale-online.target"
	install-config "${payload}/systemd/tailscaled.defaults" 'default/tailscaled'

	# Keep the systemd CacheDirectory owned by the RPM.
	install -dm755 "${pkgdir}/var/cache/tailscale"
	install-license LICENSE 'tailscale/LICENSE.nivora'
}

files() {
	files-find-binary
	files-find-systemd
	files-find-license
	# Stapler matches backup literally, before normalizing ./etc to /etc.
	printf '%s\n' '/etc/default/tailscaled'
	files-find \
		"/usr/sbin/tailscaled" \
		"/var/cache/tailscale"
}
