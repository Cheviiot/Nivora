name='tailscale'
version='1.102.4'
release=4
summary='The easiest, most secure way to use WireGuard and 2FA.'
summary_ru='Самый простой и безопасный способ использовать WireGuard и двухфакторную аутентификацию.'
group='Networking/Other'
desc='The easiest, most secure, cross platform way to use WireGuard + oauth2 + 2FA/SSO.'
desc_ru='Самый простой и безопасный кроссплатформенный способ использовать WireGuard совместно с oauth2 и 2FA/SSO.'
homepage='https://tailscale.com'
maintainer='Tailscale Inc <info@tailscale.com>'

architectures=('amd64' 'arm64')
compatible_with=('altlinux')
disable_network=1

license=('BSD-3-Clause')

provides=()
replaces=('tailscale')
conflicts=()

backup=('/etc/default/tailscaled')

auto_reqprov_method="dirty"
auto_req=0
auto_prov=0

deps=('iptables' 'iproute2' 'ca-certificates')

sources=(
	"https://pkgs.tailscale.com/stable/tailscale_${version}_amd64.tgz?~archive=false&~name=tailscale.tgz"
	"local:///tailscale-purge-data"
	'local:///LICENSE?nivora=tailscale'
)

sources_arm64=(
	"https://pkgs.tailscale.com/stable/tailscale_${version}_arm64.tgz?~archive=false&~name=tailscale.tgz"
	"local:///tailscale-purge-data"
	'local:///LICENSE?nivora=tailscale'
)

checksums=(
	'sha256:50748df1045e60b5b695f19f4c56b0da36c019948b440fb456b6584a50f0d8b9'
	'sha256:fc0e166481e2f97c21dca773ad4bfe673842268935ce1628c14b96af98e70555'
	'sha256:3c7a7d6d7f09890d5e682901acaeb12bda9542fc6450a709c9dc296a91e726a5'
)

checksums_arm64=(
	'sha256:9dd1e6a592a014bbaea0103167ffe299adeda4ba14e078ce9c2895364f6c4c3f'
	'sha256:fc0e166481e2f97c21dca773ad4bfe673842268935ce1628c14b96af98e70555'
