name='telegram'
version='7.4.4'
release=5

summary='Desktop messaging with chat synchronization'
summary_ru='Настольный мессенджер с синхронизацией переписки'
desc='Telegram Desktop is the official desktop messaging application for Telegram, with chats synchronized across devices.'
desc_ru='Telegram Desktop — официальное настольное приложение Telegram с синхронизацией переписки между устройствами.'
group='Networking/Instant messaging'
homepage='https://desktop.telegram.org/'
maintainer='Cheviiot <Cheviiot@users.noreply.github.com>'

license=('GPL-3.0-only')

appstream_app_id='org.telegram.desktop'
appstream_name='Telegram Desktop'
appstream_developer='Telegram FZ-LLC'
appstream_screenshot='https://raw.githubusercontent.com/telegramdesktop/tdesktop/bf4f714036f21c750d535dab199c811b3f9bfdd4/docs/assets/preview.png'
appstream_screenshot_caption='Chats and a group conversation'
appstream_screenshot_caption_ru='Список чатов и групповая переписка'

architectures=('amd64')
compatible_with=('altlinux_p11')
disable_network=1

provides=('telegram-desktop')
replaces=('telegram' 'telegram-desktop')
conflicts=('telegram-desktop')

# ELF scanning covers linked libraries. Keep the p11 graphics dependencies explicit.
auto_reqprov_method='dirty'
auto_req=1
auto_prov=0

deps=(
	'libharfbuzz' 'libpng16' 'libpcre2' 'libbrotlicommon' 'libbrotlidec'
	'bzlib' 'libblkid' 'libmount' 'libselinux' 'libffi8'
	'libexpat' 'libgraphite2' 'zlib' 'libX11' 'icon-theme-hicolor'
)

opt_deps=(
	'xdg-utils' 'libappindicator-gtk3' 'ca-certificates' 'libalsa'
	'libGL' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk' 'pipewire'
)

sources=(
	"https://github.com/telegramdesktop/tdesktop/releases/download/v${version}/td-setup-linux-x64-${version}.tar.xz?~archive=false&~name=tsetup.tar.xz"
	'local:///org.telegram.desktop.desktop'
	'local:///org.telegram.desktop.png'
	'local:///LICENSE?nivora=telegram'
	'local:///org.telegram.desktop.metainfo.xml?nivora=telegram'
)

checksums=(
	'sha256:607d77344a332268df1ab0c3c9b5adb70a6204e5f78cb668ab3fa58245c0888e'
	'sha256:8ceb3f6aea1003f84f1b5757cd857f8237b294bb18456e5e0e54d96e6fff04ba'
	'sha256:3fb1400c7dc9bbc3b5cb3ffedcbf4a9b09c53e28b57a7ff33a8a6b9048864090'
	'sha256:f3ad1b5ecdc1c9e5ab3719a0b084a3e0b4fc87ad424fbf81043df9637be3d1f5'
	'sha256:d063477b48ee673b566658405c792a46cce76c9050f30bec7e936dddc41ebbc5'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	executable='/opt/telegram-desktop/Telegram'
	install -dm755 "${pkgdir}/opt/telegram-desktop" "${pkgdir}/usr/bin"
	tar -xJOf tsetup.tar.xz Telegram/Telegram > "${pkgdir}${executable}"
	chmod 0755 "${pkgdir}${executable}"
	ln -sfn "${executable}" "${pkgdir}/usr/bin/telegram-desktop"

	# Register the packaged executable with Telegram's external updater interface.
	# This also keeps its Wayland app ID aligned with our desktop entry.
	install -Dm644 /dev/stdin "${pkgdir}/opt/telegram-desktop/externalupdater.d/nivora" <<< "${executable}"

	install-desktop org.telegram.desktop.desktop
	test -f "${pkgdir}/usr/share/applications/org.telegram.desktop.desktop"
	install -Dm644 org.telegram.desktop.png \
		"${pkgdir}/usr/share/icons/hicolor/256x256/apps/org.telegram.desktop.png"
	install -Dm644 org.telegram.desktop.metainfo.xml \
		"${pkgdir}/usr/share/metainfo/org.telegram.desktop.metainfo.xml"
	install-license LICENSE 'telegram/LICENSE.nivora'
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/org.telegram.desktop.metainfo.xml" \
		"/opt/telegram-desktop/**/*" \
		"/usr/share/icons/hicolor/256x256/apps/org.telegram.desktop.png"
}
