name='telegram'
version='7.2.5'
release=4
summary='New era of messaging'
summary_ru='Новая эра обмена сообщениями'
group='Networking/Instant messaging'
desc='Telegram Desktop messaging app.'
desc_ru='Telegram Desktop — приложение для обмена сообщениями.'
homepage='https://desktop.telegram.org/'
maintainer='Cheviiot <Cheviiot@users.noreply.github.com>'

architectures=('amd64')
compatible_with=('altlinux')
disable_network=1

license=('GPL-3.0-only')

appstream_app_id='org.telegram.desktop'
appstream_name='Telegram'
appstream_developer='Telegram FZ-LLC'

provides=('telegram-desktop')
replaces=('telegram' 'telegram-desktop')
conflicts=('telegram-desktop')

# auto_req covers the real DT_NEEDED of the Telegram binary (readelf -d
# confirmed: glibc, glib2/gobject/gio, libfontconfig1, libfreetype - a much
# shorter list than the old explicit one, since harfbuzz/libpng/pcre2/
# brotli/bz2/blkid/mount/selinux/ffi/expat/graphite2/zlib/X11 never show
# up directly, only (presumably) transitively via fontconfig/freetype/
# glib2's own dependency chains, or dlopen'd for optional Wayland/X11
# backend selection in X11's case. No direct evidence either way for any
# of them, so they stay explicit out of caution. icon-theme-hicolor is
# pure data, not a library, and stays explicit too.
auto_reqprov_method='dirty'
auto_req=1
auto_prov=0

deps=('libharfbuzz' 'libpng16' 'libpcre2' 'libbrotlicommon' 'libbrotlidec' 'bzlib' 'libblkid' 'libmount' 'libselinux' 'libffi8' 'libexpat' 'libgraphite2' 'zlib' 'libX11' 'icon-theme-hicolor')

opt_deps=('xdg-utils' 'libappindicator-gtk3' 'ca-certificates' 'libalsa' 'libGL' 'xdg-desktop-portal' 'xdg-desktop-portal-gtk' 'pipewire')

sources=(
	"https://td.telegram.org/tlinux/tsetup.${version}.tar.xz?~archive=false&~name=tsetup.tar.xz"
	'local:///org.telegram.desktop.desktop'
	'local:///org.telegram.desktop.png'
	'local:///LICENSE?nivora=telegram'
	'local:///org.telegram.desktop.metainfo.xml?nivora=telegram'
)

checksums=(
	'sha256:4f44bf31589ebe5c29621f01091367b192661e7933e2c3551b7820e6dfa061c0'
	'sha256:8ceb3f6aea1003f84f1b5757cd857f8237b294bb18456e5e0e54d96e6fff04ba'
	'sha256:3fb1400c7dc9bbc3b5cb3ffedcbf4a9b09c53e28b57a7ff33a8a6b9048864090'
	'sha256:f3ad1b5ecdc1c9e5ab3719a0b084a3e0b4fc87ad424fbf81043df9637be3d1f5'
	'sha256:b530326e2589420363372ceec311bf54e7a279dadc471fd34d41ea9a3520c979'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	cd "${srcdir}"

	tar --no-same-owner --no-same-permissions -xJf tsetup.tar.xz

	install -dm755 "${pkgdir}/opt/telegram-desktop"
	install -Dm755 "Telegram/Telegram" "${pkgdir}/opt/telegram-desktop/Telegram"

	install -dm755 "${pkgdir}/usr/bin"
	ln -sfn /opt/telegram-desktop/Telegram "${pkgdir}/usr/bin/telegram-desktop"

	# Telegram's Launcher::ComputeExternalUpdater() (SourceFiles/core/
	# launcher.cpp) looks for a file under <exe-dir>/externalupdater.d/ listing
	# its own binary path, and calls SetUpdaterDisabledAtStartup() if found —
	# the documented way for packagers to opt out of self-updates. It also
	# stops Telegram writing a shadow desktop/D-Bus file on launch and pins
	# desktopFileName() (the Wayland app_id) to "org.telegram.desktop" instead
	# of a per-install-path hash, which is what was breaking the taskbar icon.
	install -Dm644 /dev/stdin \
		"${pkgdir}/opt/telegram-desktop/externalupdater.d/nivora" <<'EOF'
/opt/telegram-desktop/Telegram
EOF

	install-desktop org.telegram.desktop.desktop
	install -Dm644 org.telegram.desktop.png \
		"${pkgdir}/usr/share/icons/hicolor/256x256/apps/org.telegram.desktop.png"

	# The AppStream component claims this desktop id; make the build
	# fail here rather than shipping a component nothing can launch.
	test -f "${pkgdir}/usr/share/applications/org.telegram.desktop.desktop"
	install -Dm644 "${srcdir}/org.telegram.desktop.metainfo.xml" \
		"${pkgdir}/usr/share/metainfo/org.telegram.desktop.metainfo.xml"
	install-license LICENSE "telegram/LICENSE.nivora"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/usr/share/metainfo/org.telegram.desktop.metainfo.xml" \
		"/opt/telegram-desktop/**/*" \
		"/usr/share/icons/hicolor/256x256/apps/org.telegram.desktop.png"
}
