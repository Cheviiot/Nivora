name='telegram'
version=7.1.3
release=1
summary='Official Telegram messaging client'
summary_ru='Официальный клиент мессенджера Telegram'
group='Networking/Instant messaging'
desc='Telegram Desktop is the official Telegram messaging client with cloud-synced chats, voice and video calls, and no limits on file size or media history.'
desc_ru='Telegram Desktop — официальный клиент мессенджера Telegram с облачной синхронизацией чатов, голосовыми и видеозвонками и без ограничений на размер файлов и историю медиа.'
homepage='https://desktop.telegram.org/'
maintainer='Telegram Messenger LLP <https://github.com/telegramdesktop/tdesktop>'

architectures=('amd64')

license=('GPL-3.0-only')

provides=()
replaces=('telegram')
conflicts=()

# auto_req covers the real DT_NEEDED of the Telegram binary (readelf -d
# confirmed: glibc, glib2/gobject/gio, libfontconfig1, libfreetype - a much
# shorter list than the old explicit one, since harfbuzz/libpng/pcre2/
# brotli/bz2/blkid/mount/selinux/ffi/expat/graphite2/zlib/X11 never show
# up directly, only (presumably) transitively via fontconfig/freetype/
# glib2's own dependency chains, or dlopen'd for optional Wayland/X11
# backend selection in X11's case. No direct evidence either way for any
# of them, so they stay explicit out of caution. icon-theme-hicolor is
# pure data, not a library, and stays explicit too.
auto_reqprov_method="dirty"
auto_req=1
auto_prov=1

