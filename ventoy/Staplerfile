name='ventoy'
version='1.1.17'
release=4
summary='A new bootable USB solution.'
summary_ru='Новое решение для загрузочных USB-накопителей.'
group='System/Configuration/Hardware'
desc='Ventoy is an open source tool to create a bootable USB drive for ISO, WIM, IMG, VHD(x) and EFI files. With Ventoy you do not need to format the disk repeatedly: copy the image files to the drive and boot them directly.'
desc_ru='Ventoy — открытая утилита для создания загрузочного USB-накопителя с файлами ISO, WIM, IMG, VHD(x) и EFI. С Ventoy не нужно форматировать диск заново: файлы образов копируются на накопитель и загружаются напрямую.'
homepage='https://www.ventoy.net/'
maintainer='Ventoy Project <admin@ventoy.net>'

architectures=('amd64' 'arm64')
compatible_with=('altlinux')
disable_network=1

license=('GPL-3.0-only')

appstream_app_id='ventoy'
appstream_name='Ventoy'

provides=()
replaces=('ventoy')
conflicts=()

# Official archive ships prebuilt native binaries and low-level disk tools —
# nothing here to link against locally.
auto_reqprov_method="dirty"
auto_req=0
auto_prov=0

deps=(
	'libgtk+3' 'polkit' 'parted' 'fdisk' 'dosfstools'
	'dmsetup' 'udev' 'xz'
)

opt_deps=('libqt5-widgets')

sources=(
	"https://github.com/ventoy/Ventoy/releases/download/v${version}/ventoy-${version}-linux.tar.gz?~archive=false&~name=ventoy.tar.gz"
	"https://raw.githubusercontent.com/ventoy/Ventoy/v${version}/COPYING?~archive=false&~name=COPYING"
	'local:///ventoy'
	'local:///ventoy.desktop'
	'local:///ventoy.metainfo.xml?nivora=ventoy'
)

sources_arm64=(
	"https://github.com/ventoy/Ventoy/releases/download/v${version}/ventoy-${version}-linux.tar.gz?~archive=false&~name=ventoy.tar.gz"
	"https://raw.githubusercontent.com/ventoy/Ventoy/v${version}/COPYING?~archive=false&~name=COPYING"
	'local:///ventoy'
	'local:///ventoy.desktop'
	'local:///ventoy.metainfo.xml?nivora=ventoy'
