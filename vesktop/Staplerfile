scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	cd "${srcdir}"

	mkdir -p "${srcdir}/extracted"
	ar x vesktop.deb
	tar -xf data.tar.* -C "${srcdir}/extracted"

	install -dm755 "${pkgdir}/opt"
	cp -a "${srcdir}/extracted/opt/Vesktop" "${pkgdir}/opt/"
	chmod 4755 "${pkgdir}/opt/Vesktop/chrome-sandbox"
	chmod 755 "${pkgdir}/opt/Vesktop/vesktop"

	install -dm755 "${pkgdir}/usr/bin"
	install -Dm755 vesktop-launcher "${pkgdir}/usr/bin/vesktop"

	install -dm755 "${pkgdir}/usr/share"
	cp -a "${srcdir}/extracted/usr/share/applications" "${pkgdir}/usr/share/"
	cp -a "${srcdir}/extracted/usr/share/icons" "${pkgdir}/usr/share/"

	install-license LICENSE "vesktop/LICENSE.nivora"
	install -Dm644 "${srcdir}/extracted/opt/Vesktop/LICENSES.chromium.html" \
		"${pkgdir}/usr/share/licenses/vesktop/LICENSES.chromium.html"
	install -Dm644 "${srcdir}/extracted/opt/Vesktop/LICENSE.electron.txt" \
		"${pkgdir}/usr/share/licenses/vesktop/LICENSE.electron.txt"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/opt/Vesktop/**/*" \
		"/usr/share/icons/hicolor/scalable/apps/vesktop.svg"
}
