name='vesktop'
version='1.6.7'
release=3
summary='Unofficial Discord desktop client with better Linux support'
summary_ru='Неофициальный десктопный клиент Discord с улучшенной поддержкой Linux'
group='Networking/Instant messaging'
desc='Vesktop is an unofficial Discord desktop app built by the Vencord team, aiming to give better performance and improved Linux support than the official Electron client.'
desc_ru='Vesktop — неофициальное десктопное приложение Discord от команды Vencord, нацеленное на лучшую производительность и полноценную поддержку Linux по сравнению с официальным Electron-клиентом.'
homepage='https://vencord.dev/'
maintainer='Cheviiot <Cheviiot@users.noreply.github.com>'

architectures=('amd64' 'arm64')
compatible_with=('altlinux')

license=('GPL-3.0-or-later')

provides=()
replaces=('vesktop')
conflicts=()

auto_reqprov_method="dirty"
auto_req=1
auto_prov=0
disable_network=1

# Upstream .deb's own Depends: doesn't list libgbm/libasound at all, but
# they're real DT_NEEDED entries of the vesktop binary (confirmed with ldd
# against a real install) — without them the dynamic linker refuses to
# start the process at all, it's not a soft/optional degradation. RPM builds
# discover them through auto_req; non-RPM maps keep them explicit below.
#
# The rest of this list stays explicit because none of it is a real
# DT_NEEDED of any binary in the payload (confirmed with readelf -d against
# a real install, not just by reading Chromium's source): xdg-utils is a
# subprocess tool, not a library; libnotify/libXScrnSaver/libXtst/libuuid/
# libsecret are all loaded by Chromium's Linux integration layer via
# dlopen() rather than linked, specifically so the browser degrades
# gracefully instead of hard-failing when one is missing - but Nivora wants
# the real functionality (notifications, screensaver inhibition, global
# shortcuts, keyring), not the degraded fallback, so they stay hard deps.
deps=('libnotify' 'libXScrnSaver' 'libXtst' 'xdg-utils' 'libuuid' 'libsecret')

opt_deps=('libappindicator-gtk3' 'gnome-keyring')

build_deps=('binutils')

sources=(
	"https://github.com/Vencord/Vesktop/releases/download/v${version}/vesktop_${version}_amd64.deb?~archive=false&~name=vesktop.deb"
	'local:///vesktop-launcher'
	'local:///LICENSE?nivora=vesktop'
)

