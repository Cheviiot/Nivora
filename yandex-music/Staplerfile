# Dirty SONAME discovery is enabled only on RPM targets. DEB/Ubuntu/Arch use
# the explicit package-name maps below instead of receiving RPM-style
# libfoo.so()(64bit) capabilities. AutoProv stays disabled: dirty computes a
# private SONAME set for requires filtering but does not emit package provides.
auto_reqprov_method="dirty"
auto_req=0
auto_req_altlinux=1
auto_req_fedora=1
auto_req_opensuse=1
auto_prov=0
disable_network=1

