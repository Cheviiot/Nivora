name='yandex-music'
version='5.121.2'
release=1
summary='Official Yandex Music desktop client'
summary_ru='Официальный десктопный клиент Яндекс Музыки'
group='Sound'
desc='Yandex Music is the official desktop client for the Yandex Music streaming service: personalized recommendations, curated playlists, podcasts, audiobooks and the "My Wave" endless radio.'
desc_ru='Яндекс Музыка — официальный десктопный клиент стримингового сервиса Яндекс Музыки: персональные рекомендации, подборки, подкасты, аудиокниги и бесконечное радио «Моя волна».'
homepage='https://music.yandex.ru/download/'
maintainer='Яндекс Музыка <music@support.yandex.ru>'

architectures=('amd64')
compatible_with=('altlinux')

license=('Custom')
nonfree=1
nonfree_msg='Yandex Music является проприетарным приложением ООО «Яндекс». Использование клиента, учётной записи, подписки и сетевых функций регулируется условиями Яндекс Музыки.'
nonfree_url='https://yandex.ru/legal/music_mobile_agreement/'

provides=()
replaces=('yandex-music')
conflicts=()

# ALT's own /usr/lib/rpm/find-requires would also emit set-version requires
# for the bundled Electron libraries, which only resolve if the package also
# advertises them through find-provides. The dirty finder instead subtracts
# every SONAME the payload ships itself, which is the one combination that
# keeps auto_prov disabled and still yields correct requires.
auto_reqprov_method="dirty"
auto_req=1
auto_prov=0
disable_network=1

# Starts with upstream's DEB Depends and includes every direct DT_NEEDED
# observed in the packaged Electron binary. The extra desktop-integration
# libraries are loaded dynamically and therefore cannot be inferred from ELF.
deps=(
	'libnotify' 'libXScrnSaver' 'libXtst' 'xdg-utils' 'libuuid'
	'libsecret'
)

opt_deps=('libappindicator-gtk3')

build_deps=('binutils')

sources=(
	"https://music-desktop-application.s3.yandex.net/stable/Yandex_Music_amd64_${version}.deb?~archive=false&~name=yandex-music.deb"
	'local:///LICENSE?nivora=yandex-music'
)

checksums=(
	'sha256:a5c369bfb2be56216dbbf1679930ae3c5f4fd6d2a8a4ede9961f59799a52d8c0'
	'sha256:52a11692975a1dfe999f8cf953522d2ddfc2bd594a3a23c2e52035eb53d2fa2d'
)

scripts=(
	['postinstall']='postinstall.sh'
	['postremove']='postremove.sh'
)

package() {
	cd "${srcdir}"

	mkdir -p "${srcdir}/extracted"
	ar x yandex-music.deb
	tar -xf data.tar.* -C "${srcdir}/extracted"

	install -dm755 "${pkgdir}/opt"
	cp -a "${srcdir}/extracted/opt/Яндекс Музыка" "${pkgdir}/opt/YandexMusic"
	chmod 4755 "${pkgdir}/opt/YandexMusic/chrome-sandbox"
	chmod 755 "${pkgdir}/opt/YandexMusic/yandexmusic"

	# Electron's own auto-updater has nothing to manage under Stapler.
	rm -f "${pkgdir}/opt/YandexMusic/resources/app-update.yml"

	install -dm755 "${pkgdir}/usr/bin"
	ln -sfn "/opt/YandexMusic/yandexmusic" "${pkgdir}/usr/bin/yandex-music"

	install -dm755 "${pkgdir}/usr/share"
	cp -a "${srcdir}/extracted/usr/share/applications" "${pkgdir}/usr/share/"
	cp -a "${srcdir}/extracted/usr/share/icons" "${pkgdir}/usr/share/"
	sed -i 's|Exec="/opt/Яндекс Музыка/yandexmusic" %U|Exec=/usr/bin/yandex-music %U|' \
		"${pkgdir}/usr/share/applications/yandexmusic.desktop"

	install-license LICENSE "yandex-music/LICENSE.nivora"
	install -Dm644 "${srcdir}/extracted/opt/Яндекс Музыка/LICENSES.chromium.html" \
		"${pkgdir}/usr/share/licenses/yandex-music/LICENSES.chromium.html"
	install -Dm644 "${srcdir}/extracted/opt/Яндекс Музыка/LICENSE.electron.txt" \
		"${pkgdir}/usr/share/licenses/yandex-music/LICENSE.electron.txt"
}

files() {
	files-find-binary
	files-find-desktop
	files-find-license
	files-find \
		"/opt/YandexMusic/**/*" \
		"/usr/share/icons/hicolor/*/apps/yandexmusic.png"
}
